---
interface Props {
  lang: string;
}

const { lang } = Astro.props;

const labels = {
  en: {
    name: "Full Name",
    email: "Email Address",
    phone: "Phone Number",
    zip: "ZIP Code",
    service: "Service Interested In",
    timeline: "When to Start",
    budget: "Budget Range",
    contactMethod: "Preferred Contact Method",
    message: "Message/Project Details",
    submit: "Request Quote",
  },
  es: {
    name: "Nombre Completo",
    email: "Correo Electrónico",
    phone: "Número de Teléfono",
    zip: "Código Postal",
    service: "Servicio de Interés",
    timeline: "Cuándo Desea Iniciar",
    budget: "Rango de Presupuesto",
    contactMethod: "Método de Contacto Preferido",
    message: "Mensaje/Detalles del Proyecto",
    submit: "Solicitar Presupuesto",
  },
};

const t = lang === "es" ? labels.es : labels.en;
---

<form class="contact-form" id="quote-form">
  <div class="form-group">
    <label for="name">{t.name}</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      placeholder={lang === "es" ? "Su nombre" : "Your name"}
    />
  </div>

  <div class="form-grid">
    <div class="form-group">
      <label for="email">{t.email}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder={lang === "es" ? "su@email.com" : "your@email.com"}
      />
    </div>
    <div class="form-group">
      <label for="phone">{t.phone}</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        placeholder="(515) 207-5106"
      />
    </div>
  </div>

  <div class="form-grid">
    <div class="form-group">
      <label for="zip">{t.zip}</label>
      <input type="text" id="zip" name="zip" required placeholder="50322" />
    </div>
    <div class="form-group">
      <label for="contactMethod">{t.contactMethod}</label>
      <select id="contactMethod" name="contactMethod" required>
        <option value="phone">{lang === "es" ? "Teléfono" : "Phone"}</option>
        <option value="email">{lang === "es" ? "Email" : "Email"}</option>
        <option value="text"
          >{lang === "es" ? "Mensaje de texto" : "Text"}</option
        >
        <option value="any">{lang === "es" ? "Cualquiera" : "Any"}</option>
      </select>
    </div>
  </div>

  <div class="form-group">
    <label for="projectType">{t.service}</label>
    <select id="projectType" name="projectType" required>
      <option value="" disabled selected
        >{
          lang === "es" ? "Seleccione tipo de proyecto" : "Select project type"
        }</option
      >
      <option value="kitchen">{lang === "es" ? "Cocina" : "Kitchen"}</option>
      <option value="bathroom">{lang === "es" ? "Baño" : "Bathroom"}</option>
      <option value="flooring">{lang === "es" ? "Pisos" : "Flooring"}</option>
      <option value="deck">{lang === "es" ? "Deck / Terraza" : "Deck"}</option>
      <option value="painting">{lang === "es" ? "Pintura" : "Painting"}</option>
      <option value="other">{lang === "es" ? "Otro" : "Other"}</option>
    </select>
  </div>

  <div class="form-grid">
    <div class="form-group">
      <label for="timeline">{t.timeline}</label>
      <select id="timeline" name="timeline" required>
        <option value="" disabled selected
          >{lang === "es" ? "Seleccionar" : "Select"}</option
        >
        <option value="asap"
          >{lang === "es" ? "Lo antes posible" : "ASAP"}</option
        >
        <option value="1-3months"
          >{lang === "es" ? "1-3 meses" : "1-3 months"}</option
        >
        <option value="3-6months"
          >{lang === "es" ? "3-6 meses" : "3-6 months"}</option
        >
        <option value="6plus"
          >{lang === "es" ? "Más de 6 meses" : "6+ months"}</option
        >
        <option value="planning"
          >{lang === "es" ? "Solo planeando" : "Just planning"}</option
        >
      </select>
    </div>
    <div class="form-group">
      <label for="budget"
        >{t.budget} ({lang === "es" ? "opcional" : "optional"})</label
      >
      <select id="budget" name="budget">
        <option value=""
          >{lang === "es" ? "Prefiero no decir" : "Prefer not to say"}</option
        >
        <option value="under15k">&lt; $15,000</option>
        <option value="15-30k">$15,000 - $30,000</option>
        <option value="30-50k">$30,000 - $50,000</option>
        <option value="50-75k">$50,000 - $75,000</option>
        <option value="75plus">$75,000+</option>
      </select>
    </div>
  </div>

  <div class="form-group">
    <label for="description">{t.message}</label>
    <textarea
      id="description"
      name="description"
      rows="4"
      placeholder={lang === "es"
        ? "Cuéntenos sobre su proyecto..."
        : "Tell us about your project..."}></textarea>
  </div>

  <div class="form-group checkbox-group">
    <input type="checkbox" id="dataConsent" name="dataConsent" required />
    <label for="dataConsent" class="checkbox-label">
      {
        lang === "es" ? (
          <>
            Autorizo el tratamiento de mis datos personales para ser contactado
            según la{" "}
            <a href="/es/politica-privacidad" target="_blank">
              política de privacidad
            </a>
            .
          </>
        ) : (
          <>
            I authorize the processing of my personal data to be contacted in
            accordance with the{" "}
            <a href="/en/privacy-policy" target="_blank">
              privacy policy
            </a>
            .
          </>
        )
      }
    </label>
  </div>

  <button type="submit" class="submit-btn">{t.submit}</button>
</form>

<script>
  const form = document.getElementById("quote-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    // Here we would eventually implement the Odoo integration
    alert("Thank you! This is a demo form. Integration pending.");
  });
</script>

<style>
  .contact-form {
    background: white;
    padding: var(--spacing-lg);
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }

  .form-group {
    margin-bottom: var(--spacing-sm);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(0, 45, 98, 0.1);
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .checkbox-group input[type="checkbox"] {
    margin-top: 0.3rem;
    width: auto;
    flex-shrink: 0;
  }

  .checkbox-label {
    font-size: 0.9rem;
    color: #666;
    font-weight: normal;
    cursor: pointer;
    line-height: 1.4;
    margin-bottom: 0;
  }

  .checkbox-label a {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .checkbox-label a:hover {
    color: var(--color-accent);
  }

  .submit-btn {
    width: 100%;
    background-color: var(--color-primary);
    color: white;
    padding: 1rem;
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: var(--spacing-sm);
    transition: background-color 0.2s;
  }

  .submit-btn:hover {
    background-color: #001a3d;
  }
</style>
