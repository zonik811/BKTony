---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
import { Image } from "astro:assets";
import logo2 from "../assets/images/logo2.png";

const content = {
  en: {
    tagline: "Building your dreams, one room at a time.",
    contact: "Contact Us",
    follow: "Follow Us",
    rights: "All rights reserved.",
    serviceAreaTitle: "📍 Our Service Area",
    serviceAreaDesc:
      "Serving a 50-mile radius around Des Moines, IA (ZIP 50322) with premium kitchen and bathroom renovations.",
    scheduleBtn: "Schedule Free Consultation",
    licensed: "Licensed & Insured",
    radius: "50 Miles Around 50322",
    satisfaction: "Satisfaction Guaranteed",
  },
  es: {
    tagline: "Construyendo sus sueños, habitación por habitación.",
    contact: "Contáctenos",
    follow: "Síguenos",
    rights: "Todos los derechos reservados.",
    serviceAreaTitle: "📍 Nuestra Área de Servicio",
    serviceAreaDesc:
      "Sirviendo un radio de 50 millas alrededor de Des Moines, IA (código postal 50322) con renovaciones de cocina y baño de primera calidad.",
    scheduleBtn: "Programar Consulta Gratis",
    licensed: "Con Licencia y Seguro",
    radius: "50 Millas Alrededor de 50322",
    satisfaction: "Satisfacción Garantizada",
  },
};

const t = lang === "es" ? content.es : content.en;
const homeLink = lang === "es" ? "/es" : "/en";
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={homeLink} class="footer-logo-image">
        <Image src={logo2} alt="KBTony" width={150} />
      </a>
      <p>{t.tagline}</p>
    </div>

    <div class="footer-contact">
      <h3>{t.contact}</h3>
      <p>Phone: (515) 207-5106</p>
      <p>Email: tony@kbtony.com</p>
      <p>USA</p>
    </div>

    <div class="footer-social">
      <h3>{t.follow}</h3>
      <div class="social-links">
        <a href="#" aria-label="Facebook">FB</a>
        <a href="#" aria-label="Instagram">IG</a>
        <a href="#" aria-label="LinkedIn">IN</a>
      </div>
    </div>
  </div>

  <!-- Location Map Section -->
  <div class="footer-location">
    <div class="container location-grid">
      <div class="location-info">
        <h3>{t.serviceAreaTitle}</h3>
        <p>
          {t.serviceAreaDesc}
        </p>
        <div class="location-cta">
          <a
            href={lang === "es" ? "/es#contact" : "/en#contact"}
            class="btn btn-accent">{t.scheduleBtn}</a
          >
        </div>
      </div>
      <div class="map-container">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d47877.34842566428!2d-93.67537704863281!3d41.60054487910156!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87ee9a85da0bb38b%3A0x79b9e7f9d6c5dc9c!2sDes%20Moines%2C%20IA%2050322!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%"
          height="300"
          style="border:0; border-radius: 8px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
      </div>
    </div>
  </div>

  <!-- Trust Badges -->
  <div class="footer-badges">
    <div class="container badges-grid">
      <div class="badge">
        <span class="badge-icon">🛡️</span>
        <span>{t.licensed}</span>
      </div>
      <div class="badge">
        <span class="badge-icon">📍</span>
        <span>{t.radius}</span>
      </div>
      <div class="badge">
        <span class="badge-icon">⭐</span>
        <span>{t.satisfaction}</span>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} KBTony. {t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #1a1a1a;
    color: white;
    padding-top: var(--spacing-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .footer-logo-image {
    display: block;
    max-width: 150px;
    margin-bottom: var(--spacing-sm);
  }

  .footer-logo-image img {
    height: auto;
    width: 100%;
    border-radius: 4px; /* Optional: slight corner smooth */
  }

  .text-accent {
    color: var(--color-accent);
  }

  h3 {
    color: var(--color-accent);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-sm);
  }

  .social-links {
    display: flex;
    gap: var(--spacing-sm);
  }

  .social-links a {
    background: #333;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .social-links a:hover {
    background: var(--color-accent);
  }

  .footer-location {
    background: #222;
    padding: var(--spacing-xl) 0;
    border-top: 1px solid #333;
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .location-info h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-md);
    color: white;
  }

  .location-info p {
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
    color: #ccc;
  }

  .location-cta {
    margin-top: var(--spacing-md);
  }

  .btn-accent {
    background-color: var(--color-accent);
    color: white;
    padding: 1rem 2rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    display: inline-block;
    transition: all 0.3s ease;
    animation: pulse-glow 2s infinite;
  }

  .btn-accent:hover {
    background-color: #e55d00;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 107, 0, 0.4);
  }

  @keyframes pulse-glow {
    0%,
    100% {
      box-shadow: 0 4px 15px rgba(255, 107, 0, 0.3);
    }
    50% {
      box-shadow: 0 8px 25px rgba(255, 107, 0, 0.6);
    }
  }

  .map-container {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .location-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  .footer-bottom {
    background-color: #000;
    padding: var(--spacing-sm) 0;
    text-align: center;
    font-size: 0.9rem;
    opacity: 0.7;
  }

  .footer-badges {
    background: #111;
    padding: var(--spacing-md) 0;
    border-top: 1px solid #333;
  }

  .badges-grid {
    display: flex;
    justify-content: center;
    gap: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #ccc;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .badge-icon {
    font-size: 1.2rem;
  }
</style>
