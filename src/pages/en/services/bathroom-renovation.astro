---
import Layout from '../../../layouts/Layout.astro';
import BeforeAfter from '../../../components/BeforeAfter.astro';
---

<Layout title="Bathroom Renovation Services - KBTony" lang="en">
	<main>
		<!-- Hero Section -->
		<section class="service-hero">
			<div class="container">
				<span class="category">Our Services</span>
				<h1>Bathroom Renovation</h1>
				<p class="tagline">Create your personal spa retreat with luxurious fixtures and thoughtful design.</p>
			</div>
		</section>

		<!-- Service Overview -->
		<section class="section">
			<div class="container content-grid">
				<div class="text-content">
					<h2>Transform Your Bathroom Experience</h2>
					<p>Your bathroom should be a sanctuary—a place to relax and rejuvenate. We specialize in creating spa-like retreats that combine elegance with functionality.</p>
					
					<ul class="benefits-list">
						<li>Walk-in showers with premium glass enclosures</li>
						<li>Freestanding soaking tubs</li>
						<li>Custom vanities with ample storage</li>
						<li>Heated floors and towel racks</li>
						<li>Ambient LED lighting design</li>
						<li>Water-efficient fixtures</li>
					</ul>
				</div>
				<div class="image-content">
					<img src="/images/bathroom-service.png" alt="Luxury Bathroom" />
				</div>
			</div>
		</section>

		<!-- Bathroom Services Section -->
		<section class="section bg-surface">
			<div class="container">
				<div class="section-header text-center">
					<span class="subheading">Our Bathroom Services</span>
					<h2>We do it all! Here are some of our more common bathroom transformation services.</h2>
					<div class="divider"></div>
				</div>
				
				<div class="bathroom-services-grid">
					<!-- Whole Bathroom Remodels -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bath-whole.png" alt="Whole Bathroom Remodels" />
							<div class="service-overlay">
								<h3>Whole Bathroom Remodels →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Whole Bathroom Remodels</h4>
							<p>Complete bathroom transformations from concept to completion with custom design and premium materials.</p>
						</div>
					</div>

					<!-- Shower & Bathtub Upgrades -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bath-shower.png" alt="Shower & Bathtub Upgrades" />
							<div class="service-overlay">
								<h3>Shower & Bathtub Upgrades →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Shower & Bathtub Upgrades</h4>
							<p>Modern walk-in showers, tub-to-shower conversions, and luxurious soaking tubs with custom tile work.</p>
						</div>
					</div>

					<!-- Cabinet & Countertop Vanity Installs -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bath-vanity.png" alt="Cabinet & Countertop Vanity Installs" />
							<div class="service-overlay">
								<h3>Cabinet & Countertop Vanity Installs →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Cabinet & Countertop Vanity Installs</h4>
							<p>Custom vanities with premium countertops including marble, quartz, and granite options.</p>
						</div>
					</div>

					<!-- Lighting & Mirrors -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bathroom-after.png" alt="Lighting & Mirrors" />
							<div class="service-overlay">
								<h3>Lighting & Mirrors →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Lighting & Mirrors</h4>
							<p>Elegant lighting fixtures and LED mirrors to create the perfect ambiance and functionality.</p>
						</div>
					</div>

					<!-- Tile & Flooring -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bath-tile.png" alt="Tile & Flooring" />
							<div class="service-overlay">
								<h3>Tile & Flooring →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Tile & Flooring</h4>
							<p>Designer tile installations for floors, walls, and showers in ceramic, porcelain, and natural stone.</p>
						</div>
					</div>

					<!-- Walls & Closets -->
					<div class="service-detail-card">
						<div class="service-image">
							<img src="/images/bath-closet.png" alt="Walls & Closets" />
							<div class="service-overlay">
								<h3>Walls & Closets →</h3>
							</div>
						</div>
						<div class="service-content">
							<h4>Walls & Closets</h4>
							<p>Custom storage solutions, linen closets, and organizational systems to maximize your space.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Before & After Gallery -->
		<section class="section">
			<div class="container">
				<div class="section-header text-center">
					<span class="subheading">Real Transformations</span>
					<h2>See Our Bathroom Renovations Come to Life</h2>
					<div class="divider"></div>
					<p class="section-description">Drag the slider to see the dramatic transformation of our bathroom projects.</p>
				</div>
				
				<BeforeAfter 
					beforeImage="/images/bathroom-before.png"
					afterImage="/images/bathroom-after.png"
					beforeLabel="Before"
					afterLabel="After"
				/>

				<div class="cta-inline">
					<h3>Ready to Transform Your Bathroom?</h3>
					<a href="/en#contact" class="btn btn-secondary btn-pulse">Get Free Estimate</a>
				</div>
			</div>
		</section>

		<!-- Process Section -->
		<section class="section bg-surface">
			<div class="container">
				<div class="section-header text-center">
					<span class="subheading">Our Process</span>
					<h2>Creating Your Dream Bathroom</h2>
					<div class="divider"></div>
				</div>
				
				<div class="process-grid">
					<div class="process-step">
						<div class="step-number">01</div>
						<h3>Space Planning</h3>
						<p>We optimize your bathroom layout for maximum comfort and functionality.</p>
					</div>
					<div class="process-step">
						<div class="step-number">02</div>
						<h3>Fixture Selection</h3>
						<p>Choose from high-end fixtures, tiles, and finishes that match your style.</p>
					</div>
					<div class="process-step">
						<div class="step-number">03</div>
						<h3>Professional Installation</h3>
						<p>Expert plumbing, tiling, and electrical work ensure lasting quality.</p>
					</div>
					<div class="process-step">
						<div class="step-number">04</div>
						<h3>Quality Assurance</h3>
						<p>Thorough testing and inspection guarantee everything works perfectly.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="section cta-section">
			<div class="container text-center">
				<h2>Ready for Your Bathroom Makeover?</h2>
				<p>Let's discuss how we can create your perfect bathroom retreat.</p>
				<a href="/en#contact" class="btn btn-primary btn-large">Schedule Consultation</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.service-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 6rem 0 4rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.service-hero h1 {
		font-size: 3.5rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.3rem;
		max-width: 700px;
		margin: 0 auto;
		opacity: 0.95;
	}

	.content-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-lg);
		align-items: center;
	}

	.text-content h2 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
	}

	.benefits-list {
		list-style: none;
		padding: 0;
		margin-top: var(--spacing-md);
	}

	.benefits-list li {
		padding: 0.75rem 0;
		padding-left: 2rem;
		position: relative;
		line-height: 1.6;
	}

	.benefits-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 700;
		font-size: 1.2rem;
	}

	.image-content img {
		width: 100%;
		border-radius: 8px;
		box-shadow: var(--shadow-lg);
	}

	.process-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--spacing-lg);
		margin-top: var(--spacing-lg);
	}

	.process-step {
		text-align: center;
		padding: var(--spacing-md);
	}

	.step-number {
		font-size: 3rem;
		font-weight: 700;
		color: var(--color-accent);
		opacity: 0.3;
		margin-bottom: var(--spacing-sm);
	}

	.process-step h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
	}

	.cta-section {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.cta-section p {
		font-size: 1.2rem;
		margin-bottom: var(--spacing-md);
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	.bg-surface {
		background-color: var(--color-surface);
	}

	.subheading {
		display: block;
		color: var(--color-accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: var(--spacing-xs);
		font-size: 0.9rem;
	}

	.divider {
		width: 80px;
		height: 3px;
		background-color: var(--color-accent);
		margin: var(--spacing-sm) auto var(--spacing-md);
	}

	.text-center {
		text-align: center;
	}

	.bathroom-services-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
	}

	.service-detail-card {
		background: white;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: var(--shadow-md);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.service-detail-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-lg);
	}

	.service-image {
		position: relative;
		 overflow: hidden;
		height: 280px;
	}

	.service-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.service-detail-card:hover .service-image img {
		transform: scale(1.1);
	}

	.service-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(to top, rgba(0, 45, 98, 0.95), transparent);
		padding: var(--spacing-md);
		transform: translateY(100%);
		transition: transform 0.3s ease;
	}

	.service-detail-card:hover .service-overlay {
		transform: translateY(0);
	}

	.service-overlay h3 {
		color: white;
		font-size: 1.2rem;
		margin: 0;
	}

	.service-content {
		padding: var(--spacing-md);
	}

	.service-content h4 {
		color: var(--color-primary);
		font-size: 1.15rem;
		margin-bottom: var(--spacing-xs);
	}

	.service-content p {
		color: #666;
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.section-description {
		max-width: 650px;
		margin: 0 auto var(--spacing-md);
		font-size: 1.05rem;
		color: #666;
	}

	.cta-inline {
		text-align: center;
		margin-top: var(--spacing-xl);
		padding: var(--spacing-lg);
		background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
		border-radius: 12px;
	}

	.cta-inline h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		font-size: 1.8rem;
	}

	.btn-secondary {
		background-color: white;
		color: var(--color-primary);
		border: 2px solid var(--color-primary);
	}

	.btn-secondary:hover {
		background-color: var(--color-primary);
		color: white;
	}

	.btn-pulse {
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
			box-shadow: 0 4px 6px rgba(0,0,0,0.1);
		}
		50% {
			transform: scale(1.05);
			box-shadow: 0 6px 20px rgba(255, 107, 0, 0.4);
		}
	}

	@media (max-width: 1024px) {
		.bathroom-services-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.service-hero h1 {
			font-size: 2.5rem;
		}

		.content-grid {
			grid-template-columns: 1fr;
		}

		.process-grid {
			grid-template-columns: 1fr;
		}

		.bathroom-services-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
