---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Homeowner Resources - KBTony" lang="en">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Homeowner Advice</span>
				<h1>Homeowner Resources</h1>
				<p class="tagline">Essential tools and guides for your home improvement journey</p>
			</div>
		</section>

		<!-- Resources Content -->
		<section class="section">
			<div class="container">
				<div class="resources-intro">
					<h2>Everything You Need to Know About Home Remodeling</h2>
					<p>We've compiled comprehensive resources to help you make informed decisions about your kitchen, bathroom, and home renovation projects.</p>
				</div>

				<div class="resources-grid">
					<!-- Resource 1 -->
					<div class="resource-card featured">
						<div class="resource-icon">📋</div>
						<h3>Complete Remodeling Checklist</h3>
						<p>A step-by-step guide covering everything from initial planning to project completion.</p>
						<ul class="resource-includes">
							<li>Pre-project planning worksheet</li>
							<li>Contractor interview questions</li>
							<li>Material selection guide</li>
							<li>Timeline tracking template</li>
						</ul>
						<a href="/en/advice/remodel-playbook" class="resource-link">View Playbook →</a>
					</div>

					<!-- Resource 2 -->
					<div class="resource-card">
						<div class="resource-icon">💡</div>
						<h3>Kitchen Design Ideas</h3>
						<p>Explore layout options, color schemes, and the latest trends in kitchen design.</p>
						<ul class="resource-includes">
							<li>Layout templates (L, U, Galley, Island)</li>
							<li>Color palette suggestions</li>
							<li>Storage solutions</li>
							<li>Lighting placement guide</li>
						</ul>
						<a href="/en/advice/kitchen-tips" class="resource-link">Kitchen Tips →</a>
					</div>

					<!-- Resource 3 -->
					<div class="resource-card">
						<div class="resource-icon">🚿</div>
						<h3>Bathroom Planning Guide</h3>
						<p>Transform your bathroom with expert advice on fixtures, materials, and layouts.</p>
						<ul class="resource-includes">
							<li>Fixture selection guide</li>
							<li>Waterproofing essentials</li>
							<li>Ventilation requirements</li>
							<li>Accessibility features</li>
						</ul>
						<a href="/en/advice/bathroom-tips" class="resource-link">Bathroom Tips →</a>
					</div>

					<!-- Resource 4 -->
					<div class="resource-card">
						<div class="resource-icon">💰</div>
						<h3>Budget Planning Tools</h3>
						<p>Calculate costs, compare financing options, and maximize your renovation budget.</p>
						<ul class="resource-includes">
							<li>Cost estimation calculators</li>
							<li>ROI by project type</li>
							<li>Financing options overview</li>
							<li>Money-saving tips</li>
						</ul>
						<a href="/en#contact" class="resource-link">Get Quote →</a>
					</div>

					<!-- Resource 5 -->
					<div class="resource-card">
						<div class="resource-icon">📐</div>
						<h3>Contractor Selection Guide</h3>
						<p>Learn how to find, vet, and hire the right contractor for your project.</p>
						<ul class="resource-includes">
							<li>License verification checklist</li>
							<li>Reference check questions</li>
							<li>Contract must-haves</li>
							<li>Red flags to avoid</li>
						</ul>
						<a href="/en/advice/faq" class="resource-link">View FAQ →</a>
					</div>

					<!-- Resource 6 -->
					<div class="resource-card">
						<div class="resource-icon">🔨</div>
						<h3>Material Selection Guide</h3>
						<p>Compare materials for countertops, cabinets, flooring, and more.</p>
						<ul class="resource-includes">
							<li>Countertop comparison chart</li>
							<li>Cabinet material pros/cons</li>
							<li>Flooring durability ratings</li>
							<li>Maintenance requirements</li>
						</ul>
						<a href="/en/advice/kitchen-tips#materials" class="resource-link">View Materials →</a>
					</div>
				</div>

				<!-- Quick Links Section -->
				<div class="quick-links-section">
					<h2>Quick Reference Links</h2>
					<div class="quick-links-grid">
						<div class="quick-link-card">
							<h4>🏗️ Project Phases</h4>
							<ul>
								<li><a href="#planning">Planning & Design</a></li>
								<li><a href="#permits">Permits & Approvals</a></li>
								<li><a href="#demolition">Demolition Phase</a></li>
								<li><a href="#installation">Installation Phase</a></li>
								<li><a href="#finishing">Finishing Touches</a></li>
							</ul>
						</div>
						<div class="quick-link-card">
							<h4>📊 Cost Breakdowns</h4>
							<ul>
								<li><a href="/en/advice/kitchen-tips#budget">Kitchen Budget Guide</a></li>
								<li><a href="/en/advice/bathroom-tips#budget">Bathroom Budget Guide</a></li>
								<li><a href="#labor">Labor vs Materials</a></li>
								<li><a href="#contingency">Contingency Planning</a></li>
							</ul>
						</div>
						<div class="quick-link-card">
							<h4>⏰ Timeline Planning</h4>
							<ul>
								<li><a href="/en/advice/kitchen-tips#timeline">Kitchen Timeline</a></li>
								<li><a href="/en/advice/bathroom-tips#timeline">Bathroom Timeline</a></li>
								<li><a href="#seasonal">Best Time to Remodel</a></li>
								<li><a href="#delays">Avoiding Delays</a></li>
							</ul>
						</div>
						<div class="quick-link-card">
							<h4>❓ Common Questions</h4>
							<ul>
								<li><a href="/en/advice/faq">General FAQ</a></li>
								<li><a href="/en/advice/faq">Kitchen FAQ</a></li>
								<li><a href="/en/advice/faq">Bathroom FAQ</a></li>
								<li><a href="/en#contact">Ask Our Team</a></li>
							</ul>
						</div>
					</div>
				</div>

				<!-- CTA -->
				<div class="resources-cta">
					<h3>Ready to Start Your Project?</h3>
					<p>Let our experienced team guide you from concept to completion.</p>
					<a href="/en#contact" class="btn btn-primary btn-large">Get Free Consultation</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.resources-intro {
		text-align: center;
		max-width: 800px;
		margin: 0 auto var(--spacing-xl);
	}

	.resources-intro h2 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		font-size: 2rem;
	}

	.resources-intro p {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.6;
	}

	.resources-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	.resource-card {
		background: white;
		border: 2px solid #e0e0e0;
		border-radius: 12px;
		padding: var(--spacing-lg);
		transition: all 0.3s ease;
	}

	.resource-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-lg);
		border-color: var(--color-accent);
	}

	.resource-card.featured {
		border-color: var(--color-accent);
		background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
	}

	.resource-icon {
		font-size: 3rem;
		margin-bottom: var(--spacing-md);
	}

	.resource-card h3 {
		color: var(--color-primary);
		font-size: 1.5rem;
		margin-bottom: var(--spacing-sm);
	}

	.resource-card > p {
		color: #666;
		line-height: 1.6;
		margin-bottom: var(--spacing-md);
	}

	.resource-includes {
		list-style: none;
		padding: 0;
		margin: var(--spacing-md) 0;
	}

	.resource-includes li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		color: #555;
	}

	.resource-includes li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 700;
	}

	.resource-link {
		display: inline-block;
		color: var(--color-accent);
		font-weight: 600;
		margin-top: var(--spacing-sm);
		transition: transform 0.2s ease;
	}

	.resource-link:hover {
		transform: translateX(5px);
	}

	.quick-links-section {
		background: var(--color-surface);
		padding: var(--spacing-xl);
		border-radius: 12px;
		margin: var(--spacing-xl) 0;
	}

	.quick-links-section h2 {
		color: var(--color-primary);
		text-align: center;
		margin-bottom: var(--spacing-lg);
	}

	.quick-links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--spacing-lg);
	}

	.quick-link-card h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
		font-size: 1.1rem;
	}

	.quick-link-card ul {
		list-style: none;
		padding: 0;
	}

	.quick-link-card li {
		margin-bottom: 0.5rem;
	}

	.quick-link-card a {
		color: #555;
		transition: color 0.2s ease;
	}

	.quick-link-card a:hover {
		color: var(--color-accent);
	}

	.resources-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.resources-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.resources-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}

		.resources-grid {
			grid-template-columns: 1fr;
		}

		.quick-links-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
