---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Bathroom Remodel Tips - KBTony" lang="en">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Homeowner Advice</span>
				<h1>Bathroom Remodel Tips</h1>
				<p class="tagline">Expert guidance for creating your dream bathroom</p>
			</div>
		</section>

		<!-- Tips Content -->
		<section class="section">
			<div class="container">
				<div class="tips-layout">
					<!-- Sidebar -->
					<aside class="tips-sidebar">
						<h3>In This Guide</h3>
						<ul class="tips-nav">
							<li><a href="#budget">Budget Planning</a></li>
							<li><a href="#fixtures">Choosing Fixtures</a></li>
							<li><a href="#storage">Maximizing Storage</a></li>
							<li><a href="#trends">Timeless vs Trendy</a></li>
							<li><a href="#roi">Return on Investment</a></li>
						</ul>
					</aside>

					<!-- Main Content -->
					<article class="tips-content">
						<section id="budget" class="tip-section">
							<h2>💰 Bathroom Remodel Budget Guide</h2>
							<p>Understanding costs helps you plan effectively and avoid surprises:</p>
							<div class="budget-breakdown">
								<div class="budget-item">
									<h4>Small Bathroom (5x8 ft)</h4>
									<p class="price">$6,000 - $15,000</p>
									<ul>
										<li>Basic fixtures upgrade</li>
										<li>New tile and flooring</li>
										<li>Paint and lighting</li>
									</ul>
								</div>
								<div class="budget-item">
									<h4>Medium Bathroom (8x10 ft)</h4>
									<p class="price">$15,000 - $35,000</p>
									<ul>
										<li>Premium fixtures</li>
										<li>Custom vanity</li>
										<li>Tile shower or tub upgrade</li>
									</ul>
								</div>
								<div class="budget-item">
									<h4>Luxury Master Bath</h4>
									<p class="price">$35,000 - $75,000+</p>
									<ul>
										<li>High-end finishes</li>
										<li>Walk-in shower & soaking tub</li>
										<li>Heated floors, smart features</li>
									</ul>
								</div>
							</div>
							<div class="tip-box">
								<strong>💡 Pro Tip:</strong> Allocate 5-10% of your home's value for a bathroom remodel to maximize ROI.
							</div>
						</section>

						<section id="fixtures" class="tip-section">
							<h2>🚿 Choosing the Right Fixtures</h2>
							
							<h3>Shower Options</h3>
							<div class="fixture-grid">
								<div class="fixture-card">
									<h4>Walk-In Shower</h4>
									<p><strong>Best for:</strong> Modern look, accessibility</p>
									<p><strong>Cost:</strong> $3,000-$8,000</p>
								</div>
								<div class="fixture-card">
									<h4>Tub/Shower Combo</h4>
									<p><strong>Best for:</strong> Families, space-saving</p>
									<p><strong>Cost:</strong> $1,500-$4,000</p>
								</div>
								<div class="fixture-card">
									<h4>Freestanding Tub</h4>
									<p><strong>Best for:</strong> Luxury, spa feel</p>
									<p><strong>Cost:</strong> $2,000-$6,000+</p>
								</div>
								<div class="fixture-card">
									<h4>Steam Shower</h4>
									<p><strong>Best for:</strong> Wellness, luxury</p>
									<p><strong>Cost:</strong> $5,000-$15,000</p>
								</div>
							</div>

							<h3>Vanity Selection</h3>
							<ul class="checklist">
								<li>Single vanity: 24"-48" wide (ideal for small bathrooms)</li>
								<li>Double vanity: 60"-72" wide (perfect for master baths)</li>
								<li>Floating vanities create illusion of more space</li>
								<li>Choose water-resistant materials for longevity</li>
							</ul>
						</section>

						<section id="storage" class="tip-section">
							<h2>📦 Maximizing Bathroom Storage</h2>
							<div class="storage-ideas">
								<div class="storage-item">
									<span class="storage-icon">🪞</span>
									<div>
										<h4>Medicine Cabinets with Mirrors</h4>
										<p>Double functionality - storage behind the mirror</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🚪</span>
									<div>
										<h4>Built-In Niches</h4>
										<p>Recessed shelving in shower for toiletries</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🧺</span>
									<div>
										<h4>Drawer Organizers</h4>
										<p>Maximize vanity drawers with dividers</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">📚</span>
									<div>
										<h4>Vertical Shelving</h4>
										<p>Use wall space above toilet for extra storage</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🪝</span>
									<div>
										<h4>Hooks & Towel Bars</h4>
										<p>Multiple levels for towels and robes</p>
									</div>
								</div>
							</div>
						</section>

						<section id="trends" class="tip-section">
							<h2>🎨 Timeless Design Elements</h2>
							<p>Choose these classic features that won't go out of style:</p>
							<div class="design-grid">
								<div class="design-card timeless">
									<h4>✓ Timeless Choices</h4>
									<ul>
										<li>White subway tile</li>
										<li>Marble countertops</li>
										<li>Brushed nickel fixtures</li>
										<li>Neutral color palette</li>
										<li>Classic hexagon floor tile</li>
										<li>Undermount sinks</li>
									</ul>
								</div>
								<div class="design-card trendy">
									<h4>⚠️ Trendy (Use Sparingly)</h4>
									<ul>
										<li>Bright accent colors</li>
										<li>Matte black everything</li>
										<li>Geometric patterns</li>
										<li>Vessel sinks</li>
										<li>Open shelving</li>
										<li>Unique tile shapes</li>
									</ul>
								</div>
							</div>
							<div class="tip-box">
								<strong>💡 Design Strategy:</strong> Go timeless on major elements (tile, fixtures) and trendy on easy-to-change items (accessories, towels, art).
							</div>
						</section>

						<section id="roi" class="tip-section">
							<h2>📈 Maximizing Your Return on Investment</h2>
							<p>Smart choices that increase home value:</p>
							<ul class="roi-list">
								<li><strong>High ROI (70-80% return):</strong>
									<ul>
										<li>Converting tub to walk-in shower</li>
										<li>Adding a second bathroom</li>
										<li>Upgrading to energy-efficient fixtures</li>
									</ul>
								</li>
								<li><strong>Medium ROI (50-60% return):</strong>
									<ul>
										<li>New tile and flooring</li>
										<li>Modern lighting fixtures</li>
										<li>Updated vanity and countertops</li>
									</ul>
								</li>
								<li><strong>Personal Enjoyment (Lower ROI but high satisfaction):</strong>
									<ul>
										<li>Luxury rain shower heads</li>
										<li>Heated floors</li>
										<li>Smart mirrors and technology</li>
									</ul>
								</li>
							</ul>
						</section>

						<!-- CTA -->
						<div class="advice-cta">
							<h3>Ready to Create Your Dream Bathroom?</h3>
							<p>Our bathroom renovation experts are here to bring your vision to life.</p>
							<a href="/en#contact" class="btn btn-primary btn-large">Schedule Consultation</a>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.tips-layout {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-lg);
	}

	.tips-sidebar {
		position: sticky;
		top: 100px;
		height: fit-content;
	}

	.tips-sidebar h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
	}

	.tips-nav {
		list-style: none;
		padding: 0;
	}

	.tips-nav a {
		display: block;
		padding: 0.75rem 1rem;
		color: var(--color-text-main);
		border-left: 3px solid transparent;
		transition: all 0.2s ease;
	}

	.tips-nav a:hover {
		border-left-color: var(--color-accent);
		background-color: var(--color-surface);
		color: var(--color-accent);
	}

	.tips-content {
		max-width: 800px;
	}

	.tip-section {
		margin-bottom: var(--spacing-xl);
		padding-bottom: var(--spacing-lg);
		border-bottom: 1px solid #e0e0e0;
	}

	.tip-section h2 {
		color: var(--color-primary);
		font-size: 2rem;
		margin-bottom: var(--spacing-md);
	}

	.tip-section h3 {
		color: var(--color-primary);
		font-size: 1.5rem;
		margin-top: var(--spacing-lg);
		margin-bottom: var(--spacing-sm);
	}

	.budget-breakdown {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
		margin: var(--spacing-md) 0;
	}

	.budget-item {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
		border-top: 4px solid var(--color-accent);
	}

	.budget-item h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.price {
		color: var(--color-accent);
		font-size: 1.5rem;
		font-weight: 700;
		margin: var(--spacing-sm) 0;
	}

	.budget-item ul {
		font-size: 0.9rem;
		line-height: 1.8;
	}

	.fixture-grid, .design-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-md);
		margin: var(--spacing-md) 0;
	}

	.fixture-card, .design-card {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.fixture-card h4, .design-card h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.design-card.timeless {
		border-left: 4px solid #10b981;
	}

	.design-card.trendy {
		border-left: 4px solid #f59e0b;
	}

	.design-card ul {
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.storage-ideas {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.storage-item {
		display: flex;
		gap: var(--spacing-md);
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.storage-icon {
		font-size: 2rem;
	}

	.storage-item h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: var(--spacing-md) 0;
	}

	.checklist li {
		padding: 0.75rem 0;
		padding-left: 2rem;
		position: relative;
		line-height: 1.6;
	}

	.checklist li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 700;
		font-size: 1.2rem;
	}

	.tip-box {
		background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		margin: var(--spacing-md) 0;
		border-radius: 4px;
	}

	.roi-list {
		line-height: 1.8;
	}

	.roi-list ul {
		margin-top: var(--spacing-xs);
		margin-bottom: var(--spacing-md);
	}

	.advice-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.advice-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.advice-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 1024px) {
		.tips-layout {
			grid-template-columns: 1fr;
		}

		.tips-sidebar {
			position: static;
		}

		.budget-breakdown, .fixture-grid, .design-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}
	}
</style>
