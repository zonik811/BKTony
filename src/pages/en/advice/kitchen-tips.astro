---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Kitchen Remodel Tips - KBTony" lang="en">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Homeowner Advice</span>
				<h1>Kitchen Remodel Tips</h1>
				<p class="tagline">Essential guidance to make your kitchen renovation a success</p>
			</div>
		</section>

		<!-- Tips Content -->
		<section class="section">
			<div class="container">
				<div class="tips-layout">
					<!-- Sidebar -->
					<aside class="tips-sidebar">
						<h3>In This Guide</h3>
						<ul class="tips-nav">
							<li><a href="#planning">Planning Your Budget</a></li>
							<li><a href="#layout">Choosing Your Layout</a></li>
							<li><a href="#materials">Selecting Materials</a></li>
							<li><a href="#timeline">Project Timeline</a></li>
							<li><a href="#mistakes">Common Mistakes to Avoid</a></li>
						</ul>
					</aside>

					<!-- Main Content -->
					<article class="tips-content">
						<section id="planning" class="tip-section">
							<h2>💰 Planning Your Kitchen Remodel Budget</h2>
							<p>Setting a realistic budget is the foundation of a successful kitchen remodel. Here's what you need to know:</p>
							<ul class="checklist">
								<li>Allocate 10-15% of your home's value for a mid-range remodel</li>
								<li>Set aside 15-20% extra for unexpected expenses</li>
								<li>Prioritize where you want to splurge (countertops, cabinets, appliances)</li>
								<li>Get multiple quotes from licensed contractors</li>
								<li>Consider ROI: kitchen remodels typically return 50-80% of investment</li>
							</ul>
							<div class="tip-box">
								<strong>💡 Pro Tip:</strong> Cabinets and labor typically consume 60-70% of your budget. Plan accordingly!
							</div>
						</section>

						<section id="layout" class="tip-section">
							<h2>📐 Choosing the Right Kitchen Layout</h2>
							<p>Your kitchen layout affects both functionality and aesthetics. Consider these popular options:</p>
							<div class="layout-grid">
								<div class="layout-card">
									<h4>L-Shaped</h4>
									<p>Best for: Small to medium kitchens, corner spaces</p>
									<p><strong>Pros:</strong> Efficient work triangle, open feel</p>
								</div>
								<div class="layout-card">
									<h4>U-Shaped</h4>
									<p>Best for: Serious cooks, larger spaces</p>
									<p><strong>Pros:</strong> Maximum counter space and storage</p>
								</div>
								<div class="layout-card">
									<h4>Galley</h4>
									<p>Best for: Narrow spaces, single cooks</p>
									<p><strong>Pros:</strong> Highly efficient, everything within reach</p>
								</div>
								<div class="layout-card">
									<h4>Island</h4>
									<p>Best for: Open concept, entertaining</p>
									<p><strong>Pros:</strong> Extra seating, more prep space</p>
								</div>
							</div>
						</section>

						<section id="materials" class="tip-section">
							<h2>🎨 Selecting the Best Materials</h2>
							<h3>Countertops</h3>
							<ul class="material-list">
								<li><strong>Granite:</strong> Durable, heat-resistant, unique patterns ($50-200/sq ft)</li>
								<li><strong>Quartz:</strong> Low-maintenance, non-porous, consistent look ($70-150/sq ft)</li>
								<li><strong>Marble:</strong> Luxurious, timeless, requires sealing ($75-250/sq ft)</li>
								<li><strong>Butcher Block:</strong> Warm, affordable, needs maintenance ($40-100/sq ft)</li>
							</ul>

							<h3>Cabinets</h3>
							<ul class="material-list">
								<li><strong>Solid Wood:</strong> Most durable, classic look, higher cost</li>
								<li><strong>Plywood:</strong> Strong, moisture-resistant, good value</li>
								<li><strong>MDF:</strong> Smooth finish, affordable, not ideal for moisture</li>
							</ul>
						</section>

						<section id="timeline" class="tip-section">
							<h2>⏰ Realistic Project Timeline</h2>
							<div class="timeline">
								<div class="timeline-item">
									<span class="timeline-badge">Week 1-2</span>
									<div class="timeline-content">
										<h4>Planning & Design</h4>
										<p>Finalize design, select materials, order cabinets and appliances</p>
									</div>
								</div>
								<div class="timeline-item">
									<span class="timeline-badge">Week 3</span>
									<div class="timeline-content">
										<h4>Demolition</h4>
										<p>Remove old cabinets, countertops, and appliances</p>
									</div>
								</div>
								<div class="timeline-item">
									<span class="timeline-badge">Week 4-5</span>
									<div class="timeline-content">
										<h4>Rough-In Work</h4>
										<p>Electrical, plumbing, HVAC updates</p>
									</div>
								</div>
								<div class="timeline-item">
									<span class="timeline-badge">Week 6-8</span>
									<div class="timeline-content">
										<h4>Installation</h4>
										<p>Cabinets, countertops, backsplash, appliances</p>
									</div>
								</div>
								<div class="timeline-item">
									<span class="timeline-badge">Week 9</span>
									<div class="timeline-content">
										<h4>Final Touches</h4>
										<p>Paint, hardware, cleanup, final inspection</p>
									</div>
								</div>
							</div>
						</section>

						<section id="mistakes" class="tip-section">
							<h2>⚠️ Common Mistakes to Avoid</h2>
							<div class="mistake-list">
								<div class="mistake-item">
									<span class="mistake-icon">❌</span>
									<div>
										<h4>Inadequate Lighting</h4>
										<p>Plan for layered lighting: ambient, task, and accent</p>
									</div>
								</div>
								<div class="mistake-item">
									<span class="mistake-icon">❌</span>
									<div>
										<h4>Ignoring the Work Triangle</h4>
										<p>Sink, stove, and refrigerator should form an efficient triangle</p>
									</div>
								</div>
								<div class="mistake-item">
									<span class="mistake-icon">❌</span>
									<div>
										<h4>Sacrificing Storage</h4>
										<p>Maximize cabinet space with pull-outs, lazy Susans, and vertical storage</p>
									</div>
								</div>
								<div class="mistake-item">
									<span class="mistake-icon">❌</span>
									<div>
										<h4>Choosing Trendy Over Timeless</h4>
										<p>Stick with classic styles for cabinets and major elements</p>
									</div>
								</div>
								<div class="mistake-item">
									<span class="mistake-icon">❌</span>
									<div>
										<h4>Skimping on Ventilation</h4>
										<p>Invest in a quality range hood to remove odors and moisture</p>
									</div>
								</div>
							</div>
						</section>

						<!-- CTA -->
						<div class="advice-cta">
							<h3>Ready to Start Your Kitchen Remodel?</h3>
							<p>Let our experts guide you through every step of your renovation journey.</p>
							<a href="/en#contact" class="btn btn-primary btn-large">Get Free Consultation</a>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.tips-layout {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-lg);
	}

	.tips-sidebar {
		position: sticky;
		top: 100px;
		height: fit-content;
	}

	.tips-sidebar h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		font-size: 1.2rem;
	}

	.tips-nav {
		list-style: none;
		padding: 0;
	}

	.tips-nav a {
		display: block;
		padding: 0.75rem 1rem;
		color: var(--color-text-main);
		border-left: 3px solid transparent;
		transition: all 0.2s ease;
	}

	.tips-nav a:hover {
		border-left-color: var(--color-accent);
		background-color: var(--color-surface);
		color: var(--color-accent);
	}

	.tips-content {
		max-width: 800px;
	}

	.tip-section {
		margin-bottom: var(--spacing-xl);
		padding-bottom: var(--spacing-lg);
		border-bottom: 1px solid #e0e0e0;
	}

	.tip-section:last-child {
		border-bottom: none;
	}

	.tip-section h2 {
		color: var(--color-primary);
		font-size: 2rem;
		margin-bottom: var(--spacing-md);
	}

	.tip-section h3 {
		color: var(--color-primary);
		font-size: 1.5rem;
		margin-top: var(--spacing-lg);
		margin-bottom: var(--spacing-sm);
	}

	.tip-section h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: var(--spacing-md) 0;
	}

	.checklist li {
		padding: 0.75rem 0;
		padding-left: 2rem;
		position: relative;
		line-height: 1.6;
	}

	.checklist li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 700;
		font-size: 1.2rem;
	}

	.tip-box {
		background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		margin: var(--spacing-md) 0;
		border-radius: 4px;
	}

	.layout-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-md);
		margin: var(--spacing-md) 0;
	}

	.layout-card {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
		border-left: 4px solid var(--color-accent);
	}

	.material-list {
		margin: var(--spacing-sm) 0;
		line-height: 1.8;
	}

	.timeline {
		margin: var(--spacing-lg) 0;
	}

	.timeline-item {
		display: flex;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-lg);
	}

	.timeline-badge {
		background: var(--color-accent);
		color: white;
		padding: 0.5rem 1rem;
		border-radius: 20px;
		font-weight: 600;
		white-space: nowrap;
		height: fit-content;
	}

	.timeline-content h4 {
		margin-bottom: var(--spacing-xs);
	}

	.mistake-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.mistake-item {
		display: flex;
		gap: var(--spacing-md);
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.mistake-icon {
		font-size: 2rem;
	}

	.advice-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.advice-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.advice-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 1024px) {
		.tips-layout {
			grid-template-columns: 1fr;
		}

		.tips-sidebar {
			position: static;
		}

		.layout-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}
	}
</style>
