---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Frequently Asked Questions - KBTony" lang="en">
    <main>
        <!-- Hero Section -->
        <section class="faq-hero">
            <div class="container">
                <h1>Frequently Asked Questions</h1>
                <p class="tagline">
                    Everything you need to know about our renovation services
                </p>
            </div>
        </section>

        <!-- FAQ Content -->
        <section class="section">
            <div class="container">
                <div class="faq-intro">
                    <h2>Got Questions? We've Got Answers</h2>
                    <p>
                        Find answers to the most common questions about our
                        kitchen and bathroom renovation services. Can't find
                        what you're looking for? <a href="/en/contact"
                            >Contact us</a
                        > and we'll be happy to help.
                    </p>
                </div>

                <div class="faq-grid">
                    <!-- General Questions -->
                    <div class="faq-category">
                        <h3>General Questions</h3>

                        <div class="faq-item">
                            <h4>Do you offer free consultations?</h4>
                            <p>
                                Yes! We provide free in-home consultations to
                                discuss your project, take measurements, and
                                provide a detailed quote. There's no obligation,
                                and it's the best way to get started.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>What areas do you serve?</h4>
                            <p>
                                We serve a 50-mile radius around ZIP code 50322
                                (Des Moines, IA) with full licensing and
                                insurance. If you're unsure whether we cover
                                your area, just give us a call!
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Are you licensed and insured?</h4>
                            <p>
                                Absolutely. KBTony is fully licensed, bonded,
                                and insured for your protection and peace of
                                mind. We carry comprehensive liability and
                                workers' compensation insurance.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Do you handle permits?</h4>
                            <p>
                                Yes, we handle all necessary permits and
                                inspections as part of our comprehensive
                                service. We ensure all work meets local building
                                codes and regulations.
                            </p>
                        </div>
                    </div>

                    <!-- Timeline & Process -->
                    <div class="faq-category">
                        <h3>Timeline & Process</h3>

                        <div class="faq-item">
                            <h4>
                                How long does a typical kitchen remodel take?
                            </h4>
                            <p>
                                Kitchen remodels typically take 6-12 weeks
                                depending on the scope of work. Factors include
                                size, complexity, custom orders, and any
                                structural changes needed.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>How long does a bathroom renovation take?</h4>
                            <p>
                                Most bathroom renovations take 3-6 weeks from
                                start to finish. The timeline depends on the
                                extent of work, whether we're doing a full gut
                                or cosmetic updates.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>What's the renovation process like?</h4>
                            <p>
                                We start with a consultation and design phase,
                                followed by detailed planning and material
                                selection. Once approved, we handle demolition,
                                installation, and finishing touches. You'll have
                                a dedicated project manager throughout.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Can I stay in my home during renovation?</h4>
                            <p>
                                Yes! Most clients stay in their homes during
                                renovation. We'll set up protective barriers and
                                maintain one working bathroom if we're
                                renovating multiple bathrooms.
                            </p>
                        </div>
                    </div>

                    <!-- Costs & Payment -->
                    <div class="faq-category">
                        <h3>Costs & Payment</h3>

                        <div class="faq-item">
                            <h4>How much does a kitchen remodel cost?</h4>
                            <p>
                                Kitchen remodels typically range from $25,000 to
                                $75,000+ depending on size, materials, and
                                scope. We provide detailed, itemized quotes so
                                you know exactly what you're getting.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>How much does a bathroom renovation cost?</h4>
                            <p>
                                Bathroom renovations generally range from
                                $15,000 to $40,000. The cost varies based on
                                size, fixtures, tile work, and whether plumbing
                                needs to be moved.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Do you offer financing?</h4>
                            <p>
                                We can discuss financing options during your
                                consultation. Many clients use home equity loans
                                or personal financing to fund their projects.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>What's your payment schedule?</h4>
                            <p>
                                Typically, we require a deposit to begin work,
                                progress payments at key milestones, and final
                                payment upon completion. The exact schedule is
                                outlined in your contract.
                            </p>
                        </div>
                    </div>

                    <!-- Materials & Design -->
                    <div class="faq-category">
                        <h3>Materials & Design</h3>

                        <div class="faq-item">
                            <h4>Can I choose my own materials?</h4>
                            <p>
                                Absolutely! We work with your preferences and
                                can source materials you've selected, or we can
                                guide you through our trusted supplier network
                                for quality and value.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Do you provide design services?</h4>
                            <p>
                                Yes, we offer design consultation as part of our
                                service. We'll help you maximize your space,
                                choose finishes, and create a cohesive look that
                                matches your style.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>What if I want custom cabinets?</h4>
                            <p>
                                We work with premium custom cabinet makers and
                                can design cabinetry specifically for your
                                space. Custom work typically adds 2-4 weeks to
                                the timeline.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>Do you use eco-friendly materials?</h4>
                            <p>
                                Yes! We offer sustainable options including
                                low-VOC paints, recycled materials, and
                                energy-efficient fixtures. Just let us know your
                                green building preferences.
                            </p>
                        </div>
                    </div>

                    <!-- Warranty & Support -->
                    <div class="faq-category">
                        <h3>Warranty & Support</h3>

                        <div class="faq-item">
                            <h4>Do you offer warranties?</h4>
                            <p>
                                Yes, we provide a workmanship warranty on all
                                our installations. Materials come with
                                manufacturer warranties which we'll help you
                                register and maintain.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>
                                What if something goes wrong after completion?
                            </h4>
                            <p>
                                We stand behind our work. If you experience any
                                issues, contact us immediately and we'll make it
                                right. Our reputation depends on your
                                satisfaction.
                            </p>
                        </div>

                        <div class="faq-item">
                            <h4>
                                Do you do repairs after the project is done?
                            </h4>
                            <p>
                                Yes, we're here for the long term. Whether you
                                need a minor adjustment or future updates, we're
                                happy to help our past clients.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- CTA -->
                <div class="faq-cta">
                    <h2>Still Have Questions?</h2>
                    <p>
                        We're here to help! Contact us for a free consultation.
                    </p>
                    <a href="/en/contact" class="btn btn-primary btn-large"
                        >Get in Touch</a
                    >
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .faq-hero {
        background: linear-gradient(
            135deg,
            var(--color-primary) 0%,
            #001a3d 100%
        );
        color: white;
        padding: 5rem 0 4rem;
        text-align: center;
    }

    .faq-hero h1 {
        font-size: 3.5rem;
        margin-bottom: 1rem;
    }

    .tagline {
        font-size: 1.3rem;
        opacity: 0.95;
    }

    .faq-intro {
        text-align: center;
        max-width: 700px;
        margin: 0 auto var(--spacing-xl);
    }

    .faq-intro h2 {
        color: var(--color-primary);
        font-size: 2.5rem;
        margin-bottom: var(--spacing-md);
    }

    .faq-intro p {
        font-size: 1.1rem;
        color: #666;
        line-height: 1.6;
    }

    .faq-intro a {
        color: var(--color-accent);
        font-weight: 600;
    }

    .faq-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--spacing-xl);
        margin-top: var(--spacing-xl);
    }

    .faq-category {
        background: var(--color-surface);
        padding: var(--spacing-lg);
        border-radius: 12px;
        box-shadow: var(--shadow-md);
    }

    .faq-category h3 {
        color: var(--color-primary);
        font-size: 1.5rem;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--color-accent);
    }

    .faq-item {
        margin-bottom: var(--spacing-lg);
    }

    .faq-item:last-child {
        margin-bottom: 0;
    }

    .faq-item h4 {
        color: var(--color-primary);
        font-size: 1.1rem;
        margin-bottom: var(--spacing-xs);
    }

    .faq-item p {
        color: #666;
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .faq-cta {
        text-align: center;
        margin-top: var(--spacing-xxl);
        padding: var(--spacing-xl);
        background: linear-gradient(
            135deg,
            var(--color-primary) 0%,
            #001a3d 100%
        );
        border-radius: 12px;
        color: white;
    }

    .faq-cta h2 {
        color: white;
        margin-bottom: var(--spacing-sm);
    }

    .faq-cta p {
        font-size: 1.2rem;
        margin-bottom: var(--spacing-md);
    }

    .btn-large {
        padding: 1.2rem 3rem;
        font-size: 1.1rem;
    }

    @media (max-width: 768px) {
        .faq-hero h1 {
            font-size: 2.5rem;
        }

        .faq-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
