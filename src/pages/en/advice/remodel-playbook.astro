---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Homeowner Remodel Playbook - KBTony" lang="en">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Homeowner Playbook</span>
				<h1>Complete Remodeling Playbook</h1>
				<p class="tagline">Your step-by-step guide to a successful home renovation</p>
			</div>
		</section>

		<!-- Playbook Content -->
		<section class="section">
			<div class="container">
				<div class="playbook-intro">
					<h2>Navigate Your Remodel with Confidence</h2>
					<p>This comprehensive playbook will guide you through every phase of your kitchen or bathroom remodeling project, from initial planning to final inspection.</p>
				</div>

				<!-- Phase 1 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Phase 1</span>
						<h2>Planning & Preparation (Weeks 1-4)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>✅ Define Your Goals</h3>
							<ul>
								<li>List your must-haves vs. nice-to-haves</li>
								<li>Determine your budget range</li>
								<li>Research design inspiration (Pinterest, Houzz, magazines)</li>
								<li>Measure your space accurately</li>
								<li>Consider resale value vs. personal enjoyment</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>💰 Set Your Budget</h3>
							<ul>
								<li>Calculate 10-15% of home value for kitchen</li>
								<li>Calculate 5-10% of home value for bathroom</li>
								<li>Allocate funds: 30% cabinets, 25% labor, 15% appliances, 10% countertops, 20% other</li>
								<li>Reserve 15-20% for contingencies</li>
								<li>Explore financing options if needed</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>🔍 Find Your Contractor</h3>
							<ul>
								<li>Get 3-5 quotes from licensed contractors</li>
								<li>Check licenses, insurance, and references</li>
								<li>Review portfolios of completed work</li>
								<li>Ask about warranties and guarantees</li>
								<li>Verify they pull permits where required</li>
							</ul>
							<div class="pro-tip">
								<strong>💡 Pro Tip:</strong> Never choose based on price alone. The cheapest bid often means cut corners or hidden costs.
							</div>
						</div>
					</div>
				</div>

				<!-- Phase 2 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Phase 2</span>
						<h2>Design & Selection (Weeks 5-8)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>📐 Finalize Design</h3>
							<ul>
								<li>Create detailed floor plan with contractor</li>
								<li>Plan electrical and plumbing locations</li>
								<li>Design your kitchen work triangle (sink, stove, fridge)</li>
								<li>Ensure adequate lighting (ambient, task, accent)</li>
								<li>Plan for sufficient storage</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>🎨 Select Materials</h3>
							<ul>
								<li><strong>Cabinets:</strong> Wood species, color, style, hardware</li>
								<li><strong>Countertops:</strong> Granite, quartz, marble, or butcher block</li>
								<li><strong>Flooring:</strong> Tile, hardwood, luxury vinyl</li>
								<li><strong>Backsplash:</strong> Tile material, pattern, grout color</li>
								<li><strong>Fixtures:</strong> Faucets, sinks, lighting</li>
								<li><strong>Appliances:</strong> Range, refrigerator, dishwasher, microwave</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📝 Sign Contract</h3>
							<ul>
								<li>Review all contract terms carefully</li>
								<li>Verify payment schedule (never pay all upfront)</li>
								<li>Confirm start and completion dates</li>
								<li>Ensure change order process is clear</li>
								<li>Get warranty details in writing</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Phase 3 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Phase 3</span>
						<h2>Pre-Construction (Week 9)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>🏠 Prepare Your Home</h3>
							<ul>
								<li>Clear out kitchen/bathroom completely</li>
								<li>Set up temporary kitchen if needed</li>
								<li>Protect adjacent rooms from dust</li>
								<li>Secure pets and valuables</li>
								<li>Stock up on paper plates and disposables</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📋 Final Pre-Construction</h3>
							<ul>
								<li>Confirm all materials have been ordered</li>
								<li>Verify delivery dates for cabinets and appliances</li>
								<li>Review project timeline with contractor</li>
								<li>Establish communication protocol</li>
								<li>Take before photos for insurance</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Phase 4 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Phase 4</span>
						<h2>Construction (Weeks 10-16)</h2>
					</div>
					<div class="phase-content">
						<div class="construction-timeline">
							<div class="timeline-week">
								<h4>Week 10: Demolition</h4>
								<p>Remove old cabinets, countertops, appliances, and flooring</p>
							</div>
							<div class="timeline-week">
								<h4>Week 11-12: Rough-In</h4>
								<p>Update electrical, plumbing, and HVAC. Install drywall if needed.</p>
							</div>
							<div class="timeline-week">
								<h4>Week 13: Flooring</h4>
								<p>Install new flooring before cabinets</p>
							</div>
							<div class="timeline-week">
								<h4>Week 14-15: Cabinets & Counters</h4>
								<p>Install cabinets, then template and install countertops</p>
							</div>
							<div class="timeline-week">
								<h4>Week 16: Finishing</h4>
								<p>Install backsplash, fixtures, appliances, and hardware</p>
							</div>
						</div>

						<div class="pro-tip">
							<strong>⚠️ Important:</strong> Expect delays. Weather, material availability, and hidden issues can extend timelines by 1-3 weeks.
						</div>
					</div>
				</div>

				<!-- Phase 5 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Phase 5</span>
						<h2>Final Inspection & Completion (Week 17)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>🔍 Final Walkthrough</h3>
							<ul>
								<li>Test all appliances and fixtures</li>
								<li>Check cabinet doors and drawer alignment</li>
								<li>Inspect grout and caulking</li>
								<li>Verify all outlet and switch covers installed</li>
								<li>Test lighting and dimmer switches</li>
								<li>Create punch list of any touch-ups needed</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📄 Documentation</h3>
							<ul>
								<li>Get warranties for all materials and appliances</li>
								<li>Keep receipts and invoices organized</li>
								<li>Take after photos for records</li>
								<li>Get care instructions for countertops and cabinets</li>
								<li>File permits and inspection certificates</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>💳 Final Payment</h3>
							<ul>
								<li>Verify all punch list items completed</li>
								<li>Confirm all inspections passed</li>
								<li>Release final payment only when 100% satisfied</li>
								<li>Leave honest review for contractor</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Red Flags Section -->
				<div class="red-flags-section">
					<h2>🚩 Red Flags to Watch For</h2>
					<div class="red-flags-grid">
						<div class="red-flag-item">
							<h4>Contractor asks for large upfront payment</h4>
							<p>Never pay more than 10-20% upfront. Legitimate contractors don't need full payment before starting.</p>
						</div>
						<div class="red-flag-item">
							<h4>No written contract</h4>
							<p>Always insist on a detailed written contract. Verbal agreements offer no legal protection.</p>
						</div>
						<div class="red-flag-item">
							<h4>Pressure to make quick decisions</h4>
							<p>Take time to research and compare. Good contractors won't rush you.</p>
						</div>
						<div class="red-flag-item">
							<h4>Can't provide references</h4>
							<p>Reputable contractors have happy clients willing to vouch for them.</p>
						</div>
						<div class="red-flag-item">
							<h4>Price seems too good to be true</h4>
							<p>Extremely low bids often mean shortcuts, unlicensed workers, or hidden costs.</p>
						</div>
						<div class="red-flag-item">
							<h4>Won't pull permits</h4>
							<p>Permits protect you. Contractors who avoid them may be uninsured or unlicensed.</p>
						</div>
					</div>
				</div>

				<!-- CTA -->
				<div class="playbook-cta">
					<h3>Ready to Start Your Remodeling Journey?</h3>
					<p>Let KBTony guide you through every step with expert service and proven results.</p>
					<a href="/en#contact" class="btn btn-primary btn-large">Schedule Free Consultation</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.playbook-intro {
		text-align: center;
		max-width: 800px;
		margin: 0 auto var(--spacing-xl);
	}

	.playbook-intro h2 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		font-size: 2rem;
	}

	.playbook-intro p {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.6;
	}

	.playbook-phase {
		margin-bottom: var(--spacing-xl);
		border-left: 4px solid var(--color-accent);
		padding-left: var(--spacing-lg);
	}

	.phase-header {
		margin-bottom: var(--spacing-lg);
	}

	.phase-number {
		background: var(--color-accent);
		color: white;
		padding: 0.5rem 1.5rem;
		border-radius: 20px;
		font-weight: 700;
		display: inline-block;
		margin-bottom: var(--spacing-sm);
	}

	.phase-header h2 {
		color: var(--color-primary);
		font-size: 1.8rem;
	}

	.phase-content {
		display: grid;
		gap: var(--spacing-md);
	}

	.phase-checklist {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.phase-checklist h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
		font-size: 1.3rem;
	}

	.phase-checklist ul {
		list-style: none;
		padding: 0;
	}

	.phase-checklist li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		line-height: 1.6;
	}

	.phase-checklist li::before {
		content: '▶';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-size: 0.7rem;
	}

	.pro-tip {
		background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		margin-top: var(--spacing-md);
		border-radius: 4px;
	}

	.construction-timeline {
		display: grid;
		gap: var(--spacing-sm);
	}

	.timeline-week {
		background: white;
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		border-radius: 4px;
	}

	.timeline-week h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.red-flags-section {
		background: #fff1f1;
		padding: var(--spacing-xl);
		border-radius: 12px;
		margin: var(--spacing-xl) 0;
		border: 2px solid #ff6b6b;
	}

	.red-flags-section h2 {
		color: #c92a2a;
		text-align: center;
		margin-bottom: var(--spacing-lg);
	}

	.red-flags-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-md);
	}

	.red-flag-item {
		background: white;
		padding: var(--spacing-md);
		border-radius: 8px;
		border-left: 4px solid #ff6b6b;
	}

	.red-flag-item h4 {
		color: #c92a2a;
		margin-bottom: var(--spacing-xs);
		font-size: 1.1rem;
	}

	.red-flag-item p {
		color: #666;
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.playbook-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.playbook-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.playbook-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}

		.red-flags-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
