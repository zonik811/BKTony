---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Consejos para Renovación de Baños - KBTony" lang="es">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Consejos para Propietarios</span>
				<h1>Consejos para Renovación de Baños</h1>
				<p class="tagline">Guía experta para crear el baño de sus sueños</p>
			</div>
		</section>

		<!-- Tips Content -->
		<section class="section">
			<div class="container">
				<div class="tips-layout">
					<!-- Sidebar -->
					<aside class="tips-sidebar">
						<h3>En Esta Guía</h3>
						<ul class="tips-nav">
							<li><a href="#budget">Planif. de Presupuesto</a></li>
							<li><a href="#fixtures">Elegir Accesorios</a></li>
							<li><a href="#storage">Maximizar Almacenamiento</a></li>
							<li><a href="#trends">Atemporal vs Tendencia</a></li>
							<li><a href="#roi">Retorno de Inversión</a></li>
						</ul>
					</aside>

					<!-- Main Content -->
					<article class="tips-content">
						<section id="budget" class="tip-section">
							<h2>💰 Guía de Presupuesto para Baños</h2>
							<p>Entender los costos le ayuda a planificar efectivamente y evitar sorpresas:</p>
							<div class="budget-breakdown">
								<div class="budget-item">
									<h4>Baño Pequeño (5x8 pies)</h4>
									<p class="price">$6,000 - $15,000</p>
									<ul>
										<li>Actualización de accesorios básicos</li>
										<li>Nuevos azulejos y pisos</li>
										<li>Pintura e iluminación</li>
									</ul>
								</div>
								<div class="budget-item">
									<h4>Baño Mediano (8x10 pies)</h4>
									<p class="price">$15,000 - $35,000</p>
									<ul>
										<li>Accesorios premium</li>
										<li>Vanidad personalizada</li>
										<li>Ducha o bañera mejorada</li>
									</ul>
								</div>
								<div class="budget-item">
									<h4>Baño Principal de Lujo</h4>
									<p class="price">$35,000 - $75,000+</p>
									<ul>
										<li>Acabados de alta gama</li>
										<li>Ducha walk-in y bañera</li>
										<li>Pisos calefactados, domótica</li>
									</ul>
								</div>
							</div>
							<div class="tip-box">
								<strong>💡 Consejo Pro:</strong> Asigne 5-10% del valor de su casa para una renovación de baño y maximizar el ROI.
							</div>
						</section>

						<section id="fixtures" class="tip-section">
							<h2>🚿 Elegir los Accesorios Correctos</h2>
							
							<h3>Opciones de Ducha</h3>
							<div class="fixture-grid">
								<div class="fixture-card">
									<h4>Ducha Walk-In</h4>
									<p><strong>Mejor para:</strong> Aspecto moderno, accesibilidad</p>
									<p><strong>Costo:</strong> $3,000-$8,000</p>
								</div>
								<div class="fixture-card">
									<h4>Combo Bañera/Ducha</h4>
									<p><strong>Mejor para:</strong> Familias, ahorro de espacio</p>
									<p><strong>Costo:</strong> $1,500-$4,000</p>
								</div>
								<div class="fixture-card">
									<h4>Bañera Independiente</h4>
									<p><strong>Mejor para:</strong> Lujo, sensación de spa</p>
									<p><strong>Costo:</strong> $2,000-$6,000+</p>
								</div>
								<div class="fixture-card">
									<h4>Ducha de Vapor</h4>
									<p><strong>Mejor para:</strong> Bienestar, lujo</p>
									<p><strong>Costo:</strong> $5,000-$15,000</p>
								</div>
							</div>

							<h3>Selección de Vanidad</h3>
							<ul class="checklist">
								<li>Vanidad simple: 24"-48" de ancho (ideal para baños pequeños)</li>
								<li>Vanidad doble: 60"-72" de ancho (perfecta para baños principales)</li>
								<li>Vanidades flotantes crean ilusión de más espacio</li>
								<li>Elija materiales resistentes al agua para longevidad</li>
							</ul>
						</section>

						<section id="storage" class="tip-section">
							<h2>📦 Maximizar el Almacenamiento del Baño</h2>
							<div class="storage-ideas">
								<div class="storage-item">
									<span class="storage-icon">🪞</span>
									<div>
										<h4>Gabinetes con Espejos</h4>
										<p>Doble funcionalidad - almacenamiento detrás del espejo</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🚪</span>
									<div>
										<h4>Nichos Empotrados</h4>
										<p>Estanterías empotradas en la ducha para artículos de tocador</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🧺</span>
									<div>
										<h4>Organizadores de Cajones</h4>
										<p>Maximice cajones de vanidad con divisores</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">📚</span>
									<div>
										<h4>Estanterías Verticales</h4>
										<p>Use espacio de pared sobre el inodoro para almacenamiento extra</p>
									</div>
								</div>
								<div class="storage-item">
									<span class="storage-icon">🪝</span>
									<div>
										<h4>Ganchos y Toalleros</h4>
										<p>Múltiples niveles para toallas y batas</p>
									</div>
								</div>
							</div>
						</section>

						<section id="trends" class="tip-section">
							<h2>🎨 Elementos de Diseño Atemporales</h2>
							<p>Elija estas características clásicas que no pasarán de moda:</p>
							<div class="design-grid">
								<div class="design-card timeless">
									<h4>✓ Opciones Atemporales</h4>
									<ul>
										<li>Azulejo subway blanco</li>
										<li>Encimeras de mármol</li>
										<li>Accesorios níquel cepillado</li>
										<li>Paleta de colores neutros</li>
										<li>Azulejo hexagonal clásico</li>
										<li>Lavabos bajo encimera</li>
									</ul>
								</div>
								<div class="design-card trendy">
									<h4>⚠️ Tendencia (Usar con Moderación)</h4>
									<ul>
										<li>Colores de acento brillantes</li>
										<li>Negro mate en todo</li>
										<li>Patrones geométricos</li>
										<li>Lavabos tipo vasija</li>
										<li>Estanterías abiertas</li>
										<li>Formas únicas de azulejo</li>
									</ul>
								</div>
							</div>
							<div class="tip-box">
								<strong>💡 Estrategia de Diseño:</strong> Vaya atemporal en elementos principales (azulejos, accesorios) y use tendencias en artículos fáciles de cambiar (accesorios, toallas, arte).
							</div>
						</section>

						<section id="roi" class="tip-section">
							<h2>📈 Maximizar su Retorno de Inversión</h2>
							<p>Opciones inteligentes que aumentan el valor de la casa:</p>
							<ul class="roi-list">
								<li><strong>Alto ROI (70-80% de retorno):</strong>
									<ul>
										<li>Convertir bañera a ducha walk-in</li>
										<li>Agregar un segundo baño</li>
										<li>Actualizar a accesorios eficientes</li>
									</ul>
								</li>
								<li><strong>ROI Medio (50-60% de retorno):</strong>
									<ul>
										<li>Nuevos azulejos y pisos</li>
										<li>Accesorios de iluminación modernos</li>
										<li>Vanidad y encimeras actualizadas</li>
									</ul>
								</li>
								<li><strong>Disfrute Personal (ROI menor pero alta satisfacción):</strong>
									<ul>
										<li>Duchas tipo lluvia de lujo</li>
										<li>Pisos calefactados</li>
										<li>Espejos inteligentes y tecnología</li>
									</ul>
								</li>
							</ul>
						</section>

						<!-- CTA -->
						<div class="advice-cta">
							<h3>¿Listo para Crear su Baño de Ensueño?</h3>
							<p>Nuestros expertos en renovación de baños están aquí para dar vida a su visión.</p>
							<a href="/es#contact" class="btn btn-primary btn-large">Programe Consulta</a>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* Same styles as kitchen-tips.astro */
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.tips-layout {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: var(--spacing-xl);
		margin-top: var(--spacing-lg);
	}

	.tips-sidebar {
		position: sticky;
		top: 100px;
		height: fit-content;
	}

	.tips-sidebar h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
	}

	.tips-nav {
		list-style: none;
		padding: 0;
	}

	.tips-nav a {
		display: block;
		padding: 0.75rem 1rem;
		color: var(--color-text-main);
		border-left: 3px solid transparent;
		transition: all 0.2s ease;
	}

	.tips-nav a:hover {
		border-left-color: var(--color-accent);
		background-color: var(--color-surface);
		color: var(--color-accent);
	}

	.tips-content {
		max-width: 800px;
	}

	.tip-section {
		margin-bottom: var(--spacing-xl);
		padding-bottom: var(--spacing-lg);
		border-bottom: 1px solid #e0e0e0;
	}

	.tip-section h2 {
		color: var(--color-primary);
		font-size: 2rem;
		margin-bottom: var(--spacing-md);
	}

	.tip-section h3 {
		color: var(--color-primary);
		font-size: 1.5rem;
		margin-top: var(--spacing-lg);
		margin-bottom: var(--spacing-sm);
	}

	.budget-breakdown {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
		margin: var(--spacing-md) 0;
	}

	.budget-item {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
		border-top: 4px solid var(--color-accent);
	}

	.budget-item h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.price {
		color: var(--color-accent);
		font-size: 1.5rem;
		font-weight: 700;
		margin: var(--spacing-sm) 0;
	}

	.budget-item ul {
		font-size: 0.9rem;
		line-height: 1.8;
	}

	.fixture-grid, .design-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-md);
		margin: var(--spacing-md) 0;
	}

	.fixture-card, .design-card {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.fixture-card h4, .design-card h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.design-card.timeless {
		border-left: 4px solid #10b981;
	}

	.design-card.trendy {
		border-left: 4px solid #f59e0b;
	}

	.design-card ul {
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.storage-ideas {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.storage-item {
		display: flex;
		gap: var(--spacing-md);
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.storage-icon {
		font-size: 2rem;
	}

	.storage-item h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.checklist {
		list-style: none;
		padding: 0;
		margin: var(--spacing-md) 0;
	}

	.checklist li {
		padding: 0.75rem 0;
		padding-left: 2rem;
		position: relative;
		line-height: 1.6;
	}

	.checklist li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-weight: 700;
		font-size: 1.2rem;
	}

	.tip-box {
		background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		margin: var(--spacing-md) 0;
		border-radius: 4px;
	}

	.roi-list {
		line-height: 1.8;
	}

	.roi-list ul {
		margin-top: var(--spacing-xs);
		margin-bottom: var(--spacing-md);
	}

	.advice-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.advice-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.advice-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 1024px) {
		.tips-layout {
			grid-template-columns: 1fr;
		}

		.tips-sidebar {
			position: static;
		}

		.budget-breakdown, .fixture-grid, .design-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}
	}
</style>
