---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Guía de Remodelación - KBTony" lang="es">
	<main>
		<!-- Hero Section -->
		<section class="advice-hero">
			<div class="container">
				<span class="category">Guía para Propietarios</span>
				<h1>Guía Completa de Remodelación</h1>
				<p class="tagline">Su guía paso a paso para una renovación exitosa del hogar</p>
			</div>
		</section>

		<!-- Playbook Content -->
		<section class="section">
			<div class="container">
				<div class="playbook-intro">
					<h2>Navegue su Remodelación con Confianza</h2>
					<p>Esta guía completa lo orientará a través de cada fase de su proyecto de remodelación de cocina o baño, desde la planificación inicial hasta la inspección final.</p>
				</div>

				<!-- Fase 1 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Fase 1</span>
						<h2>Planificación y Preparación (Semanas 1-4)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>✅ Defina sus Objetivos</h3>
							<ul>
								<li>Liste sus imprescindibles vs. opcionales</li>
								<li>Determine su rango de presupuesto</li>
								<li>Investigue inspiración de diseño (Pinterest, Houzz, revistas)</li>
								<li>Mida su espacio con precisión</li>
								<li>Considere valor de reventa vs. disfrute personal</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>💰 Establezca su Presupuesto</h3>
							<ul>
								<li>Calcule 10-15% del valor de casa para cocina</li>
								<li>Calcule 5-10% del valor de casa para baño</li>
								<li>Asigne fondos: 30% gabinetes, 25% mano de obra, 15% electrodomésticos, 10% encimeras, 20% otros</li>
								<li>Reserve 15-20% para contingencias</li>
								<li>Explore opciones de financiamiento si es necesario</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>🔍 Encuentre su Contratista</h3>
							<ul>
								<li>Obtenga 3-5 cotizaciones de contratistas con licencia</li>
								<li>Verifique licencias, seguros y referencias</li>
								<li>Revise portafolios de trabajo completado</li>
								<li>Pregunte sobre garantías</li>
								<li>Verifique que obtengan permisos cuando sea requerido</li>
							</ul>
							<div class="pro-tip">
								<strong>💡 Consejo Pro:</strong> Nunca elija basado solo en precio. La oferta más barata a menudo significa atajos o costos ocultos.
							</div>
						</div>
					</div>
				</div>

				<!-- Fase 2 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Fase 2</span>
						<h2>Diseño y Selección (Semanas 5-8)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>📐 Finalice el Diseño</h3>
							<ul>
								<li>Cree plano detallado con contratista</li>
								<li>Planifique ubicaciones eléctricas y de plomería</li>
								<li>Diseñe su triángulo de trabajo de cocina (fregadero, estufa, refrigerador)</li>
								<li>Asegure iluminación adecuada (ambiental, de tareas, de acento)</li>
								<li>Planifique almacenamiento suficiente</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>🎨 Seleccione Materiales</h3>
							<ul>
								<li><strong>Gabinetes:</strong> Especie de madera, color, estilo, herrajes</li>
								<li><strong>Encimeras:</strong> Granito, cuarzo, mármol o madera</li>
								<li><strong>Pisos:</strong> Azulejo, madera, vinilo de lujo</li>
								<li><strong>Backsplash:</strong> Material de azulejo, patrón, color de lechada</li>
								<li><strong>Accesorios:</strong> Grifos, fregaderos, iluminación</li>
								<li><strong>Electrodomésticos:</strong> Estufa, refrigerador, lavavajillas, microondas</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📝 Firme el Contrato</h3>
							<ul>
								<li>Revise todos los términos del contrato cuidadosamente</li>
								<li>Verifique cronograma de pagos (nunca pague todo por adelantado)</li>
								<li>Confirme fechas de inicio y finalización</li>
								<li>Asegure que el proceso de órdenes de cambio esté claro</li>
								<li>Obtenga detalles de garantía por escrito</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Fase 3 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Fase 3</span>
						<h2>Pre-Construcción (Semana 9)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>🏠 Prepare su Hogar</h3>
							<ul>
								<li>Vacíe completamente cocina/baño</li>
								<li>Configure cocina temporal si es necesario</li>
								<li>Proteja habitaciones adyacentes del polvo</li>
								<li>Asegure mascotas y objetos de valor</li>
								<li>Abastézcase de platos desechables</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📋 Pre-Construcción Final</h3>
							<ul>
								<li>Confirme que todos los materiales han sido ordenados</li>
								<li>Verifique fechas de entrega de gabinetes y electrodomésticos</li>
								<li>Revise cronograma del proyecto con contratista</li>
								<li>Establezca protocolo de comunicación</li>
								<li>Tome fotos de antes para el seguro</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Fase 4 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Fase 4</span>
						<h2>Construcción (Semanas 10-16)</h2>
					</div>
					<div class="phase-content">
						<div class="construction-timeline">
							<div class="timeline-week">
								<h4>Semana 10: Demolición</h4>
								<p>Remover gabinetes viejos, encimeras, electrodomésticos y pisos</p>
							</div>
							<div class="timeline-week">
								<h4>Semana 11-12: Instalación Base</h4>
								<p>Actualizar eléctrico, plomería y HVAC. Instalar drywall si es necesario.</p>
							</div>
							<div class="timeline-week">
								<h4>Semana 13: Pisos</h4>
								<p>Instalar nuevos pisos antes de gabinetes</p>
							</div>
							<div class="timeline-week">
								<h4>Semana 14-15: Gabinetes y Encimeras</h4>
								<p>Instalar gabinetes, luego plantilla e instalar encimeras</p>
							</div>
							<div class="timeline-week">
								<h4>Semana 16: Acabados</h4>
								<p>Instalar backsplash, accesorios, electrodomésticos y herrajes</p>
							</div>
						</div>

						<div class="pro-tip">
							<strong>⚠️ Importante:</strong> Espere retrasos. Clima, disponibilidad de materiales y problemas ocultos pueden extender cronogramas 1-3 semanas.
						</div>
					</div>
				</div>

				<!-- Fase 5 -->
				<div class="playbook-phase">
					<div class="phase-header">
						<span class="phase-number">Fase 5</span>
						<h2>Inspección Final y Finalización (Semana 17)</h2>
					</div>
					<div class="phase-content">
						<div class="phase-checklist">
							<h3>🔍 Recorrido Final</h3>
							<ul>
								<li>Pruebe todos los electrodomésticos y accesorios</li>
								<li>Verifique alineación de puertas y cajones de gabinetes</li>
								<li>Inspeccione lechada y sellado</li>
								<li>Verifique que todas las cubiertas de tomacorrientes estén instaladas</li>
								<li>Pruebe iluminación y interruptores reguladores</li>
								<li>Cree lista de retoques necesarios</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>📄 Documentación</h3>
							<ul>
								<li>Obtenga garantías para todos los materiales y electrodomésticos</li>
								<li>Mantenga recibos y facturas organizados</li>
								<li>Tome fotos después para registros</li>
								<li>Obtenga instrucciones de cuidado para encimeras y gabinetes</li>
								<li>Archive permisos y certificados de inspección</li>
							</ul>
						</div>

						<div class="phase-checklist">
							<h3>💳 Pago Final</h3>
							<ul>
								<li>Verifique que todos los elementos de lista estén completados</li>
								<li>Confirme que todas las inspecciones pasaron</li>
								<li>Libere pago final solo cuando esté 100% satisfecho</li>
								<li>Deje reseña honesta para contratista</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Red Flags Section -->
				<div class="red-flags-section">
					<h2>🚩 Señales de Alerta</h2>
					<div class="red-flags-grid">
						<div class="red-flag-item">
							<h4>Contratista pide gran pago inicial</h4>
							<p>Nunca pague más del 10-20% por adelantado. Contratistas legítimos no necesitan pago completo antes de comenzar.</p>
						</div>
						<div class="red-flag-item">
							<h4>Sin contrato escrito</h4>
							<p>Siempre insista en un contrato escrito detallado. Acuerdos verbales no ofrecen protección legal.</p>
						</div>
						<div class="red-flag-item">
							<h4>Presión para tomar decisiones rápidas</h4>
							<p>Tómese tiempo para investigar y comparar. Buenos contratistas no lo apurarán.</p>
						</div>
						<div class="red-flag-item">
							<h4>No puede proporcionar referencias</h4>
							<p>Contratistas reputables tienen clientes satisfechos dispuestos a dar referencias.</p>
						</div>
						<div class="red-flag-item">
							<h4>Precio parece demasiado bueno</h4>
							<p>Ofertas extremadamente bajas a menudo significan atajos, trabajadores sin licencia o costos ocultos.</p>
						</div>
						<div class="red-flag-item">
							<h4>No obtiene permisos</h4>
							<p>Los permisos lo protegen. Contratistas que los evitan pueden no tener seguro o licencia.</p>
						</div>
					</div>
				</div>

				<!-- CTA -->
				<div class="playbook-cta">
					<h3>¿Listo para Comenzar su Viaje de Remodelación?</h3>
					<p>Permita que KBTony lo guíe en cada paso con servicio experto y resultados probados.</p>
					<a href="/es#contact" class="btn btn-primary btn-large">Programe Consulta Gratis</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* Same styles as English version */
	.advice-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 4rem 0 3rem;
		text-align: center;
	}

	.category {
		color: var(--color-accent);
		text-transform: uppercase;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 2px;
	}

	.advice-hero h1 {
		font-size: 3rem;
		margin: 1rem 0;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.9;
	}

	.playbook-intro {
		text-align: center;
		max-width: 800px;
		margin: 0 auto var(--spacing-xl);
	}

	.playbook-intro h2 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		font-size: 2rem;
	}

	.playbook-intro p {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.6;
	}

	.playbook-phase {
		margin-bottom: var(--spacing-xl);
		border-left: 4px solid var(--color-accent);
		padding-left: var(--spacing-lg);
	}

	.phase-header {
		margin-bottom: var(--spacing-lg);
	}

	.phase-number {
		background: var(--color-accent);
		color: white;
		padding: 0.5rem 1.5rem;
		border-radius: 20px;
		font-weight: 700;
		display: inline-block;
		margin-bottom: var(--spacing-sm);
	}

	.phase-header h2 {
		color: var(--color-primary);
		font-size: 1.8rem;
	}

	.phase-content {
		display: grid;
		gap: var(--spacing-md);
	}

	.phase-checklist {
		background: var(--color-surface);
		padding: var(--spacing-md);
		border-radius: 8px;
	}

	.phase-checklist h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
		font-size: 1.3rem;
	}

	.phase-checklist ul {
		list-style: none;
		padding: 0;
	}

	.phase-checklist li {
		padding: 0.5rem 0;
		padding-left: 1.5rem;
		position: relative;
		line-height: 1.6;
	}

	.phase-checklist li::before {
		content: '▶';
		position: absolute;
		left: 0;
		color: var(--color-accent);
		font-size: 0.7rem;
	}

	.pro-tip {
		background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		margin-top: var(--spacing-md);
		border-radius: 4px;
	}

	.construction-timeline {
		display: grid;
		gap: var(--spacing-sm);
	}

	.timeline-week {
		background: white;
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-md);
		border-radius: 4px;
	}

	.timeline-week h4 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-xs);
	}

	.red-flags-section {
		background: #fff1f1;
		padding: var(--spacing-xl);
		border-radius: 12px;
		margin: var(--spacing-xl) 0;
		border: 2px solid #ff6b6b;
	}

	.red-flags-section h2 {
		color: #c92a2a;
		text-align: center;
		margin-bottom: var(--spacing-lg);
	}

	.red-flags-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-md);
	}

	.red-flag-item {
		background: white;
		padding: var(--spacing-md);
		border-radius: 8px;
		border-left: 4px solid #ff6b6b;
	}

	.red-flag-item h4 {
		color: #c92a2a;
		margin-bottom: var(--spacing-xs);
		font-size: 1.1rem;
	}

	.red-flag-item p {
		color: #666;
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.playbook-cta {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: var(--spacing-xl);
		border-radius: 12px;
		text-align: center;
		margin-top: var(--spacing-xl);
	}

	.playbook-cta h3 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.playbook-cta p {
		margin-bottom: var(--spacing-md);
		font-size: 1.1rem;
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	@media (max-width: 768px) {
		.advice-hero h1 {
			font-size: 2rem;
		}

		.red-flags-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
