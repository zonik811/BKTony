---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import heroKitchen from '../../assets/images/hero-kitchen.png';
import bathroomService from '../../assets/images/bathroom-service.png';
import roofAfter from '../../assets/images/roof-after.png';
import flooringHero from '../../assets/images/flooring_hero.png';
import deckHero from '../../assets/images/deck_hero.png';
import paintingService from '../../assets/images/painting-service.png';
---

<Layout title="Nuestros Servicios - KBTony" lang="es">
	<main>
		<!-- Hero Section -->
		<section class="services-hero">
			<div class="container">
				<h1>Nuestros Servicios Premium de Remodelación</h1>
				<p class="tagline">Transforme su hogar con nuestros servicios expertos de renovación de cocinas, baños y exteriores</p>
			</div>
		</section>

		<!-- Services Grid -->
		<section class="section">
			<div class="container">
				<div class="services-intro">
					<h2>Lo Que Hacemos Mejor</h2>
					<p>Con años de experiencia e innumerables clientes satisfechos, nos especializamos en transformar hogares con artesanía de precisión y materiales premium.</p>
				</div>

				<div class="services-grid">
					<ServiceCard
						title="Remodelación de Cocinas"
						description="Transformaciones completas de cocina con gabinetes personalizados, encimeras premium y electrodomésticos modernos."
						icon="🍳"
                        image={heroKitchen}
						detailLink="/es/servicios/remodelacion-cocinas"
					/>
					<ServiceCard
						title="Renovación de Baños"
						description="Mejoras de baño de lujo con duchas walk-in, bañeras tipo spa y accesorios elegantes."
						icon="🚿"
                        image={bathroomService}
						detailLink="/es/servicios/renovacion-banos"
					/>
					<ServiceCard
						title="Techos y Exteriores"
						description="Soluciones de techado duraderas y mejoras exteriores que protegen y embellecen su hogar."
						icon="🏠"
                        image={roofAfter}
						detailLink="/es/servicios/techos-exteriores"
					/>
					<ServiceCard
						title="Pisos"
						description="Instalación premium de madera, azulejos y vinilo de lujo para calidez y estilo."
						icon="🪵"
                        image={flooringHero}
						detailLink="/es/servicios/pisos"
					/>
					<ServiceCard
						title="Decks y Terrazas"
						description="Espacios de vida al aire libre personalizados, decks y pérgolas diseñados para extender su área de vida."
						icon="🏗️"
                        image={deckHero}
						detailLink="/es/servicios/decks"
					/>
					<ServiceCard
						title="Pintura Profesional"
						description="Servicios de pintura interior y exterior impecables para renovar la apariencia de su hogar."
						icon="🖌️"
                        image={paintingService}
						detailLink="/es/servicios/pintura"
					/>
				</div>
			</div>
		</section>

		<!-- Why Choose Us -->
		<section class="section bg-surface">
			<div class="container">
				<div class="why-choose">
					<h2>¿Por Qué Elegir KBTony?</h2>
					<div class="benefits-grid">
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Licenciados y Asegurados</h3>
							<p>Contratistas totalmente licenciados con seguro integral para su tranquilidad.</p>
						</div>
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Materiales Premium</h3>
							<p>Solo usamos materiales de alta calidad de marcas confiables para resultados duraderos.</p>
						</div>
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Artesanía Experta</h3>
							<p>Nuestro equipo calificado entrega atención al detalle en cada proyecto.</p>
						</div>
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Precios Transparentes</h3>
							<p>Cotizaciones claras sin tarifas ocultas. Sabe exactamente lo que está pagando.</p>
						</div>
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Finalización a Tiempo</h3>
							<p>Respetamos su tiempo con cronogramas realistas y gestión eficiente de proyectos.</p>
						</div>
						<div class="benefit-card">
							<div class="benefit-icon">✓</div>
							<h3>Satisfacción Garantizada</h3>
							<p>Respaldamos nuestro trabajo con garantías completas.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Process Section -->
		<section class="section">
			<div class="container">
				<h2 class="text-center">Nuestro Proceso Simple</h2>
				<div class="process-steps">
					<div class="process-step">
						<div class="step-number">1</div>
						<h3>Consulta Gratuita</h3>
						<p>Programe una reunión para discutir su visión y obtener una cotización detallada.</p>
					</div>
					<div class="process-step">
						<div class="step-number">2</div>
						<h3>Diseño y Planificación</h3>
						<p>Trabaje con nuestro equipo para crear el diseño perfecto para su espacio.</p>
					</div>
					<div class="process-step">
						<div class="step-number">3</div>
						<h3>Instalación Experta</h3>
						<p>Nuestros artesanos expertos dan vida a su visión con precisión.</p>
					</div>
					<div class="process-step">
						<div class="step-number">4</div>
						<h3>Inspección Final</h3>
						<p>Aseguramos que todo cumpla con nuestros altos estándares antes de completar.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="section cta-section">
			<div class="container text-center">
				<h2>¿Listo para Transformar su Hogar?</h2>
				<p>Obtenga una consulta gratuita y descubra cómo podemos dar vida a su visión.</p>
				<a href="/es#contact" class="btn btn-primary btn-large">Obtenga Cotización Gratis</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* Same styles as English version */
	.services-hero {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
		padding: 5rem 0 4rem;
		text-align: center;
	}

	.services-hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
	}

	.tagline {
		font-size: 1.3rem;
		max-width: 700px;
		margin: 0 auto;
		opacity: 0.95;
	}

	.services-intro {
		text-align: center;
		max-width: 700px;
		margin: 0 auto var(--spacing-xl);
	}

	.services-intro h2 {
		color: var(--color-primary);
		font-size: 2.5rem;
		margin-bottom: var(--spacing-md);
	}

	.services-intro p {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.6;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	.why-choose h2 {
		color: var(--color-primary);
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: var(--spacing-xl);
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--spacing-lg);
	}

	.benefit-card {
		text-align: center;
		padding: var(--spacing-lg);
		background: white;
		border-radius: 8px;
		box-shadow: var(--shadow-md);
		transition: transform 0.3s ease;
	}

	.benefit-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-lg);
	}

	.benefit-icon {
		width: 60px;
		height: 60px;
		background: var(--color-accent);
		color: white;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
		font-weight: 700;
		margin: 0 auto var(--spacing-md);
	}

	.benefit-card h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
	}

	.benefit-card p {
		color: #666;
		line-height: 1.6;
	}

	.process-steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--spacing-lg);
		margin-top: var(--spacing-xl);
	}

	.process-step {
		text-align: center;
		padding: var(--spacing-md);
	}

	.step-number {
		width: 60px;
		height: 60px;
		background: var(--color-accent);
		color: white;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.8rem;
		font-weight: 700;
		margin: 0 auto var(--spacing-md);
	}

	.process-step h3 {
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
	}

	.process-step p {
		color: #666;
		line-height: 1.6;
	}

	.cta-section {
		background: linear-gradient(135deg, var(--color-primary) 0%, #001a3d 100%);
		color: white;
	}

	.cta-section h2 {
		color: white;
		margin-bottom: var(--spacing-sm);
	}

	.cta-section p {
		font-size: 1.2rem;
		margin-bottom: var(--spacing-md);
	}

	.btn-large {
		padding: 1.2rem 3rem;
		font-size: 1.1rem;
	}

	.bg-surface {
		background-color: var(--color-surface);
	}

	.text-center {
		text-align: center;
	}

	@media (max-width: 768px) {
		.services-hero h1 {
			font-size: 2.5rem;
		}

		.services-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
