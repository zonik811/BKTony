---
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import Testimonials from "../../components/Testimonials.astro";
import heroKitchen from "../../assets/images/hero-kitchen.png";
import bathroomService from "../../assets/images/bathroom-service.png";

import flooringHero from "../../assets/images/flooring_hero.png";
import deckHero from "../../assets/images/deck_hero.png";
import paintingService from "../../assets/images/painting-service.png";
import publicidad1 from "../../assets/images/publicidad1.jpeg";

const optimizedHero = await getImage({
    src: heroKitchen,
    format: "webp",
    quality: 90,
});
---

<Layout title="KBTony - Cocinas y Baños de Lujo" lang="es">
    <main>
        <!-- Hero Section -->
        <section
            class="hero"
            style={`background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url(${optimizedHero.src});`}
        >
            <div class="container hero-content">
                <h1>
                    Transforme Su Hogar con <span class="text-accent"
                        >Elegancia</span
                    >
                </h1>
                <p>
                    Servicios de Remodelación de Cocinas y Baños de Primera
                    Clase.
                </p>
                <div class="cta-group">
                    <a
                        href="/es#contact"
                        class="btn btn-primary btn-large btn-pulse"
                        >Obtenga Cotización Gratis</a
                    >
                    <a href="/es/servicios" class="btn btn-outline"
                        >Nuestros Servicios</a
                    >
                </div>
            </div>

            <!-- Handyman Hook Section -->
            <section class="handyman-hook">
                <div class="container hook-content">
                    <div class="hook-text">
                        <span class="hook-label">Servicio Nuevo</span>
                        <h2>¿Necesita una Reparación Rápida?</h2>
                        <p>
                            Desde grifos que gotean hasta armado de muebles,
                            nuestro servicio experto de mantenimiento lo
                            resuelve.
                        </p>
                    </div>
                    <div class="hook-action">
                        <a
                            href="/es/servicios/handyman"
                            class="btn btn-accent btn-large"
                            >Solucionarlo Ahora &rarr;</a
                        >
                    </div>
                </div>
            </section>

            <!-- About Section -->
            <section class="section bg-surface" id="about">
                <div class="container">
                    <div class="about-grid">
                        <div class="text-center">
                            <span class="subheading">Sobre Nosotros</span>
                            <h2>Experimente el Arte de Vivir</h2>
                            <div class="divider"></div>
                            <p class="lead">
                                En KBTony, no solo renovamos; revitalizamos.
                                Especializados en remodelación de cocinas y
                                baños de alta gama, damos vida a su visión con
                                precisión, materiales de calidad y un estilo
                                atemporal.
                            </p>
                        </div>
                        <div class="about-image">
                            <Image
                                src={publicidad1}
                                alt="KBTony Vehículo de Servicio"
                                class="rounded-shadow"
                                width={600}
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Services Section -->
            <section class="section" id="services">
                <div class="container">
                    <div class="section-header text-center">
                        <span class="subheading">Lo Que Hacemos</span>
                        <h2>Nuestros Servicios Premium</h2>
                        <div class="divider"></div>
                    </div>
                    <div class="services-grid">
                        <ServiceCard
                            title="Remodelación de Cocinas"
                            description="Gabinetes personalizados, encimeras de piedra y electrodomésticos modernos diseñados para el artista culinario."
                            image={heroKitchen}
                            detailLink="/es/servicios/remodelacion-cocinas"
                            lang="es"
                        />
                        <ServiceCard
                            title="Renovación de Baños"
                            description="Retiros estilo spa con duchas a ras de suelo, bañeras independientes e iluminación ambiental."
                            image={bathroomService}
                            detailLink="/es/servicios/renovacion-banos"
                            lang="es"
                        />

                        <ServiceCard
                            title="Pisos"
                            description="Instalación premium de madera, baldosas y vinilo de lujo."
                            image={flooringHero}
                            detailLink="/es/servicios/pisos"
                            lang="es"
                        />
                        <ServiceCard
                            title="Decks y Terrazas"
                            description="Espacios de vida al aire libre personalizados, decks y pérgolas."
                            image={deckHero}
                            detailLink="/es/servicios/decks"
                            lang="es"
                        />
                        <ServiceCard
                            title="Pintura Profesional"
                            description="Servicios de pintura interior impecables para renovar su hogar."
                            image={paintingService}
                            detailLink="/es/servicios/pintura"
                            lang="es"
                        />
                    </div>
                </div>
            </section>

            <!-- Testimonials Section -->
            <Testimonials lang="es" />

            <!-- Gallery Section (Placeholder for now) -->
            <section class="section bg-surface" id="gallery">
                <div class="container">
                    <div class="section-header text-center">
                        <span class="subheading">Portafolio</span>
                        <h2>Nuestras Obras Maestras</h2>
                        <div class="divider"></div>
                    </div>
                    <div class="gallery-grid">
                        <div class="gallery-item large">
                            <Image
                                src={heroKitchen}
                                alt="Proyecto 1"
                                width={600}
                            />
                        </div>
                        <div class="gallery-item">
                            <Image
                                src={bathroomService}
                                alt="Proyecto 2"
                                width={400}
                            />
                        </div>
                        <div class="gallery-item">
                            <Image
                                src={heroKitchen}
                                alt="Proyecto 3"
                                width={400}
                            />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Contact Section -->
            <section class="section" id="contact">
                <div class="container">
                    <div class="contact-layout">
                        <div class="contact-info">
                            <span class="subheading">Contáctenos</span>
                            <h2>Inicie Su Proyecto Soñado Hoy</h2>
                            <p>
                                ¿Listo para transformar su espacio? Utilice el
                                formulario para solicitar una consulta y
                                presupuesto gratuitos.
                            </p>
                            <div class="info-list">
                                <div class="info-item">
                                    <strong>Teléfono:</strong> (515) 207-5106
                                </div>
                                <div class="info-item">
                                    <strong>Email:</strong> tony@kbtony.com
                                </div>
                            </div>
                        </div>
                        <div class="contact-form-wrapper">
                            <ContactForm lang="es" />
                        </div>
                    </div>
                </div>
            </section>
        </section>
    </main>

    <style>
        .hero {
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--color-text-light);
            padding: 160px 0;
            text-align: center;
            position: relative;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: var(--spacing-md);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        p.lead {
            font-size: 1.2rem;
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.8;
            color: #555;
        }

        .hero p {
            font-size: 1.5rem;
            max-width: 700px;
            margin: 0 auto var(--spacing-md);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        }

        .text-accent {
            color: var(--color-accent);
        }

        .subheading {
            display: block;
            color: var(--color-accent);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: var(--spacing-xs);
            font-size: 0.9rem;
        }

        .divider {
            width: 80px;
            height: 3px;
            background-color: var(--color-accent);
            margin: var(--spacing-sm) auto var(--spacing-md);
        }

        .text-center {
            text-align: center;
        }

        .bg-surface {
            background-color: var(--color-surface);
        }

        .cta-group {
            display: flex;
            gap: var(--spacing-sm);
            justify-content: center;
            margin-top: var(--spacing-md);
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: 4px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: var(--color-accent);
            color: var(--color-primary);
        }

        .btn-primary:hover {
            background: white;
            color: var(--color-primary);
            transform: translateY(-2px);
        }

        .btn-outline {
            border: 2px solid var(--color-text-light);
            color: var(--color-text-light);
        }

        .btn-outline:hover {
            background: var(--color-text-light);
            color: var(--color-primary);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-md);
            margin-top: var(--spacing-md);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--spacing-sm);
            margin-top: var(--spacing-md);
        }

        .gallery-item img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 4px;
            transition: transform 0.3s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.02);
        }

        .contact-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            align-items: center;
        }

        @media (max-width: 768px) {
            .contact-layout {
                grid-template-columns: 1fr;
            }
            h1 {
                font-size: 2.5rem;
            }
        }

        .info-item {
            margin-top: var(--spacing-md);
            font-size: 1.1rem;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--spacing-lg);
            align-items: center;
        }

        @media (min-width: 768px) {
            .about-grid {
                grid-template-columns: 1fr 1fr;
                text-align: left;
            }
            .about-grid .text-center {
                text-align: left;
            }
            .about-grid .divider {
                margin-left: 0;
            }
        }

        .rounded-shadow {
            border-radius: 8px;
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
        }

        /* Handyman Hook Styles */
        .handyman-hook {
            background: white;
            padding: var(--spacing-md) 0;
            border-bottom: 4px solid var(--color-accent);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            position: relative;
            z-index: 10;
        }

        .hook-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--spacing-lg);
        }

        .hook-text {
            text-align: left;
        }

        .hook-text h2 {
            color: var(--color-primary);
            margin: 0;
            font-size: 1.8rem;
        }

        .hook-text p {
            margin: 0.5rem 0 0;
            color: #555;
            font-size: 1.1rem;
        }

        .hook-label {
            background: var(--color-accent);
            color: white;
            padding: 0.2rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: inline-block;
        }

        .btn-accent {
            background-color: var(--color-accent);
            color: white;
            border: none;
            white-space: nowrap;
        }

        .btn-accent:hover {
            background-color: #e55a00;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
        }

        @media (max-width: 768px) {
            .handyman-hook {
                text-align: center;
                padding: var(--spacing-lg) 0;
            }

            .hook-content {
                flex-direction: column;
                gap: var(--spacing-md);
            }

            .hook-text {
                text-align: center;
            }

            .hook-action,
            .hook-action .btn {
                width: 100%;
            }
        }
    </style>
</Layout>
